/dts-v1/;

#include "ipq5332-rdp-common.dtsi"
#include "ipq5332-rdp-common-ub.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5332 TB-MI05.1";
	compatible = "qcom,ipq5332-tb-mi05.1", "qcom,ipq5332";

	soc@0 {
		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@24 {
				phy-reset-gpio = <&tlmm 51 0>;
				phy_addr = <24>;
				phy_type = <QCA8081_PHY_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				max_speed = <2500>;
				xgmac;
			};

			phy1: phy@28 {
				phy-reset-gpio = <&tlmm 22 0>;
				phy_addr = <28>;
				phy_type = <QCA8081_PHY_TYPE>;
				id = <2>;
				uniphy_id = <1>;
				uniphy_type = <0>;
				max_speed = <2500>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			status = "okay";
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8081_lan_rst {
			pins = "gpio51";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_8081_wan_rst {
			pins = "gpio22";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	blsp1_i2c1_pinmux: blsp1_i2c1_pins {
		blsp1_scl {
			pins = "gpio29";
			function = "blsp1_i2c0";
			drive-strength = <8>;
			bias-pull-up;
		};

		blsp1_sda {
			pins = "gpio30";
			function = "blsp1_i2c0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&blsp1_i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&blsp1_i2c1_pinmux>;
	status = "okay";
};
