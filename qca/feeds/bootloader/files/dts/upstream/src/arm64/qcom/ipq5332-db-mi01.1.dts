/dts-v1/;

#include "ipq5332-rdp-common.dtsi"
#include "ipq5332-rdp-common-ub.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5332 DB-MI01.1";
	compatible = "qcom,ipq5332-db-mi01.1", "qcom,ipq5332";

	soc@0 {
		hs_m31phy_0: hs_m31phy@7b000 {
			status = "okay";
		};

		usb0: usb@8af8800 {
			qcom,select-utmi-as-pipe-clk;
			status = "okay";

			dwc3@8a00000 {
				phys = <&hs_m31phy_0>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@8 {
				phy-reset-gpio = <&tlmm 22 0>;
				phy_addr = <8>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				xgmac;
			};

			phy1: phy@0 {
				phy-reset-gpio = <&tlmm 24 0>;
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <2>;
				uniphy_id = <1>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			status = "okay";
		};
	};
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_aquantia_p1_rst {
			pins = "gpio22";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_p2_rst {
			pins = "gpio24";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie2_default_state: pcie2-default-state {
		pins = "gpio44";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pcie1_default_state: pcie1-default-state {
		pins = "gpio47";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pcie0_default_state: pcie0-default-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};
};

&pcie2 {
	pinctrl-0 = <&pcie2_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&pcie1_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	phys = <&pcie1_phy>;
	phy-names = "pciephy";
	status = "okay";
};

&pcie0 {
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
	status = "okay";
};
