/dts-v1/;

#include "ipq5332-rdp468.dts"
#include "ipq5332-rdp-common-ub.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ5332 RDP468";
	compatible = "qcom,ipq5332-rdp468", "qcom,ipq5332";

	regulator_fixed_5p0: regulator-s0500 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <500000>;
		regulator-max-microvolt = <500000>;
		regulator-boot-on;
		regulator-always-on;
		regulator-name = "fixed_5p0";
	};

	soc@0{
		ss_uniphy_0: ss_uniphy@4b0000 {
			qcom,multiplexed-phy;
			status = "okay";
		};

		hs_m31phy_0: hs_m31phy@7b000 {
			status = "okay";
		};

		usb0: usb@8af8800 {
			status = "okay";

			dwc3@8a00000 {
				phys = <&hs_m31phy_0>, <&ss_uniphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				maximum-speed = "super-speed";
			};
		};

		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: ethernet-switch@1 {
				phy-reset-gpio = <&tlmm 51 0>;
				dev-mode = <0x2>;
				phy_addr = <1>;
				phy_type = <QCA8x8x_SWITCH_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				max_speed = <2500>;
				force-speed;
				xgmac;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port0: port@0 {
						phy_addr = <0>;
						label = "cpu";
						phy-mode = "2500base-x";
						fixed-link {
							speed = <2500>;
							full-duplex;
						};
					};

					port1: port@1 {
						phy_addr = <1>;
						label = "lan";
					};

					port2: port@2 {
						phy_addr = <2>;
						label = "lan";
					};

					port3: port@3 {
						phy_addr = <3>;
						label = "lan";
					};
				};
			};

			phy1: phy@4 {
				phy_addr = <4>;
				phy_type = <QCA8x8x_BYPASS_TYPE>;
				id = <2>;
				uniphy_id = <1>;
				uniphy_type = <0>;
				max_speed = <2500>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			50mhz = <1>;
			status = "okay";
		};

	};
};

&blsp1_spi0 {
	pinctrl-0 = <&spi_0_data_clk_pins &spi_0_cs_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "micron,n25q128a11", "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <50000000>;
	};
};

/* PINCTRL */

&tlmm {

	mdio_pinmux: mdio {
		mdc {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8x8x_rst {
			pins = "gpio51";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi_0_data_clk_pins: spi-0-data-clk-state {
		pins = "gpio14", "gpio15", "gpio16";
		function = "blsp0_spi";
		drive-strength = <2>;
		bias-pull-down;
	};

	spi_0_cs_pins: spi-0-cs-state {
		pins = "gpio17";
		function = "blsp0_spi";
		drive-strength = <2>;
		bias-pull-up;
	};

	blsp1_i2c1_pinmux: blsp1_i2c1_pins {
		blsp1_scl {
			pins = "gpio29";
			function = "blsp1_i2c0";
			drive-strength = <8>;
			bias-pull-up;
		};

		blsp1_sda {
			pins = "gpio30";
			function = "blsp1_i2c0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_default_state: pcie1-default-state {
		pins = "gpio47";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};
};

&blsp1_i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&blsp1_i2c1_pinmux>;
	status = "okay";
};

&pcie1 {
	pinctrl-0 = <&pcie1_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	status = "okay";
};
