/dts-v1/;

#include "ipq9574-rdp-common.dtsi"
#include "ipq9574-rdp-common-ub.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ9574/RDP467";
	compatible = "qcom,ipq9574-RDP467", "qcom,ipq9574";

	soc@0 {
		qmp_ssphy_0: ssphy@7D000 {
			status = "okay";
		};

		qusb2_phy_0: qusb2@7B000 {
			status = "okay";
		};

		usb0: usb@8af8800 {
			status = "okay";

			dwc3@8a00000 {
				phys = <&qusb2_phy_0>, <&qmp_ssphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				maximum-speed = "super-speed";
			};
		};

		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@16 {
				phy-reset-gpio = <&tlmm 60 0>;
				phy_addr = <16>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy1: phy@17 {
				phy_addr = <17>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <2>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy2: phy@18 {
				phy_addr = <18>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <3>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy3: phy@19 {
				phy_addr = <19>;
				phy_type = <QCA8075_PHY_TYPE>;
				id = <4>;
				uniphy_id = <0>;
				uniphy_type = <0>;
			};

			phy4: phy@8 {
				phy-reset-gpio = <&tlmm 36 0>;
				phy_addr = <8>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <5>;
				uniphy_id = <1>;
				uniphy_type = <1>;
				xgmac;
			};

			phy5: phy@0 {
				phy_addr = <0>;
				phy_type = <AQ_PHY_TYPE>;
				phy-mode = "usxgmii";
				id = <6>;
				uniphy_id = <2>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			pinctrl-names = "default";
			pinctrl-0 = <&phy_rst_pinmux>;
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			phy-handle2 = <&phy2>;
			phy-handle3 = <&phy3>;
			phy-handle4 = <&phy4>;
			phy-handle5 = <&phy5>;
			status = "okay";
		};

		pcie0: pci@28000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci0_pin>;
			status = "okay";
			perst-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
		};

		pcie1: pci@10000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci1_pin>;
			status = "okay";
			perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
		};

		pcie2: pci@20000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci2_pin>;
			status = "okay";
			perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
		};

		pcie3: pci@18000000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pci3_pin>;
			status = "okay";
			perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
		};
	};
};

&blsp1_i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&blsp1_i2c3_pinmux>;
	status = "okay";
};

&tlmm {
	mdio_pinmux: mdio {
		mdc {
			pins = "gpio38";
			function = "mdc";
			drive-strength = <8>;
			bias-disable;
		};

		mdio {
			pins = "gpio39";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	phy_rst_pinmux: phy_rst {
		qti_8085_rst {
			pins = "gpio60";
			drive-strength = <8>;
			bias-pull-up;
		};

		qti_aquantia_rst {
			pins = "gpio36";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pci0_pin: pci0-default-state {
		pins = "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pci1_pin: pci1-default-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pci2_pin: pci2-default-state {
		pins = "gpio29";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	pci3_pin: pci3-default-state {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-low;
	};

	blsp1_i2c3_pinmux: blsp_i2c3_pins {
		blsp3_scl {
			pins = "gpio15";
			function = "blsp3_i2c";
			drive-strength = <8>;
			bias-pull-up;
		};

		blsp3_sda {
			pins = "gpio16";
			function = "blsp3_i2c";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
