if ARCH_IPQ

config SYS_SOC
	default "ipq"

config SYS_VENDOR
	string "IPQ board vendor"
	default "qualcomm"
	help
	  Allows to specify vendor for the IPQ SoCs based boards.
	  Based on this option board/<CONFIG_SYS_VENDOR>/<CONFIG_SYS_BOARD>
	  will be used as the custom board directory.

config SYS_BOARD
	string "IPQ SoCs based board"
	help
	  Allows to specify the IPQ SoCs based board name.
	  Based on this option board/<CONFIG_SYS_VENDOR>/<CONFIG_SYS_BOARD>
	  will be used as the custom board directory.

config SYS_CONFIG_NAME
	string "Board configuration name"
	default SYS_BOARD if SYS_BOARD != ""
	default "qcom"
	help
	  This option contains information about board configuration name.
	  Based on this option include/configs/<CONFIG_SYS_CONFIG_NAME>.h header
	  will be used for board configuration.

config SYS_MALLOC_LEN
	default 0x100000
	help
	  This specifies the size of DRAM reserved for malloc() use.

config SYS_MALLOC_F_LEN
	default 0x10000
	help
	  This specifies the size of the malloc() pool for use before relocation.

config TEXT_SIZE
	hex "Define Size of u-boot text size in DDR region"
	default 0x1C0000 if TARGET_IPQ9574
	default 0x180000 if TARGET_IPQ5332 || TARGET_IPQ5424
	help
	  This option defines the size of the u-boot text in DDR region.

config SPL_TEXT_SIZE
	hex "Define Size of u-boot SPL text size in SRAM region"
	default 0x4B000
	depends on SPL
	help
	  This option defines the size of the u-boot SPL text in SRAM region.

config SPL_RDP_IMAGE_GENERATION
	bool "Generate SPL RDP variant images"
	depends on SPL
	depends on SPL_REMAKE_ELF
	default n
	help
	  Enable generation of per-RDP SPL image variants for Qualcomm IPQ
	  platforms. When enabled, the SPL build discovers matching RDP device
	  trees, prunes them to SPL nodes and emits the corresponding SPL ELF
	  outputs.

config SPL_DDR2_MEM_BASE
       bool "Enable DDR2 memory region for SPL"
       depends on SPL
       default n
       help
         This option enables a second DDR memory region in the SPL memory map.
         When enabled, the SPL will configure MMU mappings for an additional
         DDR region at a higher address space (0x800000000). This is useful
         for platforms with extended memory configurations that require
         access to memory beyond the primary DDR region.

config ARCH_32BIT_SUPPORT
	bool "IPQSOC 32-bit support"
	select CPU_V7A
	select SYS_ARCH_TIMER
	select SYS_THUMB_BUILD
	default n
	help
	  This config provides support for 32-bit IPQSOC.

config IPQ_I2C
        bool "Enable I2C support in IPQ SOC"
        select I2C
        select DM_I2C
        select SYS_I2C_GENI if (TARGET_IPQ5424 || TARGET_IPQ5210 || TARGET_IPQ9650)
	select SYS_I2C_QUP if (TARGET_IPQ5332 || TARGET_IPQ9574)
        select CMD_I2C

config SPL_QCOM_FUSE_VOLTAGE_CONTROL
	bool "Qualcomm fuse based voltage control in SPL"
	depends on SPL
	depends on SPL_DM
	depends on SPL_DRIVERS_MISC
	depends on SPL_DM_REGULATOR
	help
	  Enable the Qualcomm fuse based voltage-control driver in SPL.
	  This lets early boot code read CPR fuse values, compute the
	  requested rail voltage and program the configured regulator before
	  DDR initialization starts.

config SPL_MP8899_REGULATOR
	bool "MP8899 I2C regulator in SPL"
	depends on SPL
	depends on SPL_DM
	depends on SPL_DM_I2C
	depends on SPL_DM_REGULATOR
	help
	  Enable the MP8899 I2C regulator backend used by Qualcomm fuse
	  voltage control in SPL.

