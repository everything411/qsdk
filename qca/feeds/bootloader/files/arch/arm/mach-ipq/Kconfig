	  booted bank information.

config BOOT_BANK_IMEM_READ
	bool "Read booted bank information from IMEM"
	depends on BOOT_BANK_FIXUP
	default n

config BOOT_BANK_SMEM_READ
	bool "Read booted bank information from SMEM"
	depends on BOOT_BANK_FIXUP
	default n

choice
	prompt "IPQ board select"

config TARGET_IPQ5332
	bool "QCOM IPQ5332 SOC"
	imply DMA
	imply DMA_CHANNELS
	imply BOOTCONFIG_V2
	imply SCM_V1
	imply IPQ_SECURE
	select BAM_DMA if DMA
	select IPQ_NET
	select QCOM_NSS_SWITCH
	imply PHY_QCA_8X8X
	imply PHY_QCA_81XX
	imply PHY_QCA_8081
	imply PHY_QCA_8033
	imply PHY_AQUANTIA
	imply PHY_QCE_1204
	imply PHY_QCE_2204
	imply CLK_QCOM_NSSCC_QCE2204
	select CMD_CACHE
	imply IPQ_I2C
	imply FUSE_IPQ
	imply LIST_FUSE
	imply SECURE_AUTH_V1 if IPQ_SECURE && SCM_V1
	imply FUSEIPQ_V1 if IPQ_SECURE && SCM_V1
	imply LIST_FUSE_V2 if IPQ_SECURE && SCM_V1
	imply VERSION_ROLLBACK_PARTITION_INFO if IPQ_SECURE
	imply IPQ_QCN9224_FUSING
	imply DPR_VER_2_0
	imply IPQ_SMP_CMD_SUPPORT
	imply IPQ_SMP64_CMD_SUPPORT
	imply CMD_AES_256
	imply MMC
	imply SUPPORT_EMMC_BOOT
	imply AES_256_DERIVE_KEY
	imply IPQ_PCIE
	imply IPQ_USB
	imply PHY if IPQ_USB
	imply PHY_QCOM_USB_HS_M31 if IPQ_USB
	imply PHY_QCOM_UNI_SSPHY if IPQ_USB
	imply CB_CALIB
	help
	  Support for the IPQ53XX SoC.
	  - Board Open Platform Specifications.
	  - Quad Cores A53, Nom@1.2G ,Turbo@1.5G, L1@32KB L2@512KB
	  - DDR3L/DDR4
	  - QSPI NAND / NOR / eMMC
	  - USB 3.0/I2C/UART/PCIe Gen3 2Lane
	  - 1G/2.5G/10G Ethernet Ports

