	  - Quad Cores A53, Nom@1.2G, L1@32KB L2@512KB
	  - DDR3L/DDR4
	  - QSPI NAND / NOR / eMMC
	  - USB 3.0/I2C/UART/PCIe Gen3 2Lane
	  - 2.5G/10G Ethernet Ports

config TARGET_IPQ9650
	bool "QTI IPQ9650"
	imply QCOM_GENI_SE
	imply IPQ_MULTI_DTB_SUPPORT
	imply NOR_BLK
	select CMD_CACHE
	imply MISC
	imply IPQ_BOARD_DEFAULT
	imply GPT_UPDATE_PARAMS
	imply DMA
	imply DMA_CHANNELS
	imply IPQ_USB
	imply PHY if IPQ_USB
	imply PHY_QCOM_USB_FEMTO if IPQ_USB
	imply PHY_QCOM_QMP_USB3 if IPQ_USB
	imply IPQ_PCIE
	imply IPQ_QCN9224_FUSING
	imply EDL_SUPPORT
	imply LIST_FUSE
	imply IPQ_TMEL_IPC_SUPPORT
	imply LIST_FUSE_V2 if IPQ_SECURE && SCM_V2 || IPQ_TMEL_IPC_SUPPORT
	imply IPQ_I2C
	imply SCM_V2
	imply IPQ_SECURE
	imply CMD_AES_256
	imply AES_256_DERIVE_KEY
	imply SECURE_AUTH_V3 if IPQ_SECURE && SCM_V2 || IPQ_TMEL_IPC_SUPPORT
	imply RUNTIME_SF_ENV_UPDATE if ENV_IS_IN_SPI_FLASH
	imply IPQ_NET if !SPL
	imply QCOM_NSS_SWITCH_V2 if !SPL
	imply NSS_PPE_V4 if !SPL
	imply PHY_QCA_81XX if !SPL
	imply PHY_QCE_1204 if !SPL
	imply PHY_QCE_2204 if !SPL
	imply CLK_QCOM_NSSCC_QCE2204 if !SPL
	imply CLK_QCOM_CMN_PLL if !SPL
        select TEE
        select OPTEE
        imply FUSE_IPQ
        imply FUSEIPQ_V3 if IPQ_SECURE && SCM_V2
	imply FAILSAFE_V2
	imply BOOT_BANK_FIXUP
	select BOOT_BANK_SMEM_READ

	help
	  Support for IPQ9650 SoC.
	  - Board Open Platform Specifications.
	  - Quad Cores A55, Nom@1.9G + Single core A78, Nom@2.05G
	  - L1@32KB L2@512KB
	  - DDR3L/DDR4
	  - QSPI NAND / NOR / eMMC
	  - USB 3.0/I2C/UART/PCIe Gen3 2Lane
	  - 2.5G/10G Ethernet Ports

endchoice

