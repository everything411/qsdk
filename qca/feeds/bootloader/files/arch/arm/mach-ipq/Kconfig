config IPQ_NAND
	bool "Enable NAND flash support in IPQ SOC"
	select MTD
	select DM_MTD
	select CMD_MTD
	select NAND_QTI
	select MTD_RAW_NAND
	select MTD_UBI
	select UBI_WRITE
	select CMD_NAND
	select CMD_UBI
	help
	  Enables support for QPIC NAND controller and its dependent drivers.
	  This option is required to use NAND flash devices connected via the
	  QPIC interface on supported platforms.

config IPQ_ART_UBI_SUPPORT
	bool "Support UBI-formatted ART partition"
	depends on IPQ_NAND
	default y if TARGET_IPQ5210
        default y if TARGET_IPQ9650
	default n
	help
	  Enables runtime detection of a UBI-formatted ART partition in
	  ipq_get_partition_data(). When the ART partition is UBI-formatted,
	  reads are dispatched through ubi_volume_read() instead of the raw
	  nand_read() path. Detection is done by validating the UBI erase
	  counter header (magic + CRC32) at the partition's first PEB, so
	  raw ART partitions are unaffected and continue to use the existing
	  raw NAND read path.

	  Only enable this on platforms where the ART partition may be
	  provisioned as a UBI volume.

config SPL_SYS_NAND_SELF_INIT
		bool "use self init nand"
		depends on !SPL_NAND_SIMPLE
		depends on SPL
		help
		  This option, if enabled, provides more flexible and linux-like
		  NAND initialization process, in SPL.

config SPL_NAND_INIT
		bool "use nand init from nand.c"
		depends on SPL
		help
		  This option, if enabled, uses the standard nand_init function from
		  nand.c in SPL. This provides a consistent NAND initialization process
		  between SPL and the main U-Boot, ensuring proper NAND device setup.

config SPL_NAND_QTI
		bool "support SPL QTI NAND controller"
		depends on SPL
		select SPL_SYS_NAND_SELF_INIT
		help
		  Enable this driver for NAND flash in ipq platform

config IPQ_SPI_NOR
