config IPQ_TMEL_PRNG_IPC_SUPPORT
	bool "Enable TMEL PRNG IPC Support"
	depends on IPQ_TMEL_IPC_SUPPORT
	default n
	help
	  Enable support for getting random data from TME PRNG (Pseudo Random
	  Number Generator) via TMEL IPC. This feature allows the bootloader
	  to request cryptographically secure random data from the TME-L
	  firmware during the boot process.

config IPQ_LCP_DARE
       bool "Enable LCP DARE Key Support"
       depends on IPQ_TMEL_PRNG_IPC_SUPPORT
       default n
       help
         Enable support for retrieving LCP-DARE keys via TMEL IPC.
         This feature allows the bootloader to obtain encryption keys for
         LCP DARE operations during the boot process. The keys are stored
         in the QCLib interface table for use by subsequent boot stages.
config IPQ_SOFTSKU_SUPPORT
	bool "Enable SoftSKU License Support"
	depends on IPQ_TMEL_IPC_SUPPORT
	depends on SPL
	default n
	help
	  Enable support for SoftSKU license management via TME-L IPC.
	  This allows dynamic feature enablement based on installed licenses,
	  including hardware feature enforcement and DDR limitation for
	  entry-level SKUs.

config IPQ_DYNAMIC_RELOCATION
	bool "Enable dynamic U-Boot relocation"
	default n
	help
	  When enabled, U-Boot performs normal relocation to the top of RAM
	  on standard boot. It runs in-place only when a crashdump path is
	  detected at runtime. This replaces the unconditional relocation skip.

