			      <0x0 0x3A000000 0x0 0x01000000>,
			      <0x0 0x07A00000 0x0 0x00010000>;
			reg-names = "edma_hw", "ppe_base", "uniphy_base";

			tdm_mode = <1>;
			bridge_mode;
