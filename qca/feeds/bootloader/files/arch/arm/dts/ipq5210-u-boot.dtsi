					};
				};
				port@5 {
					port_id = <5>;
					l1scheduler {
						group@0 {
							sp = <8>;
							cfg = <0 8 0 8>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <32>;
							ucast_loop_pri = <8>;
							mcast_queue = <288>;
							mcast_loop_pri = <4>;
							cfg = <8 0 32 0 32>;
						};
					};
				};
				port@6 {
					port_id = <6>;
					l1scheduler {
						group@0 {
							sp = <10>;
							sp_loop_pri = <15>;
							sp_max_pri = <1>;
							cfg = <6 0 10 0 10>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <40>;
							ucast_loop_pri = <120>;
							ucast_max_pri = <8>;
							mcast_queue = <292>;
							mcast_loop_pri = <4>;
							cfg = <10 0 40 0 40>;
						};
					};
				};
				port@7 {
					port_id = <7>;
					l1scheduler {
						group@0 {
							sp = <42>;
							sp_loop_pri = <2>;
							sp_max_pri = <1>;
							cfg = <0 42 0 42>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <160>;
							ucast_loop_pri = <10>;
							ucast_max_pri = <8>;
							mcast_queue = <296>;
							mcast_loop_pri = <4>;
							cfg = <42 0 160 0 160>;
						};
					};
				};
			};
		};

		watchdog: non-sec@b017000 {
			compatible = "qcom,apss-wdt-ipq5210", "qcom,kpss-wdt";
			reg =  <0x0 0xb017000 0x0 0x1000>;
			clocks = <&sleep_clk>;
			timeout-sec = <30>;
			status = "okay";
		};
	};
};

&tlmm {
	uart1-state {
		bootph-all;
	};

	qspi_pinmux: nand {
		bootph-all;

		qspi_data {
			bootph-all;
			pins = "gpio0", "gpio1", "gpio2","gpio3";
			function = "qspi_data";
			drive-strength = <6>;
			bias-pull-up;
		};

		qspi_cs_n {
			bootph-all;
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <6>;
			bias-pull-up;
		};

		qspi_clk {
			bootph-all;
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <6>;
			bias-disable;
		};
        };

	sdc_default_state: sdc-default-state {
		bootph-all;

		clk-pins {
			bootph-all;
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			bootph-all;
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			bootph-all;
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi0_pinmux: spi0 {
		bootph-all;

		spi0_sclk {
			bootph-all;
			pins = "gpio6";
			function = "qup_se0_l2";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_cs0 {
			bootph-all;
			pins = "gpio7";
			function = "qup_se0_l3";
			drive-strength = <8>;
			bias-pull-up;
		};

		spi0_miso {
			bootph-all;
			pins = "gpio8";
			function = "qup_se0_l0";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_mosi {
			bootph-all;
			pins = "gpio9";
			function = "qup_se0_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio_pins: mdio-state {
		mux_0 {
			pins = "gpio26";
			function = "mdc_mst";
			drive-strength = <8>;
			bias-pull-up;
		};

		mux_1 {
			pins = "gpio27";
			function = "mdio_mst";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&sdhc {
	bootph-all;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	sdhci-caps-mask = <0x0 0x04000000>;
	sdhci-caps = <0x0 0x04000000>;
	resets = <&gcc GCC_SDCC_BCR>;
	reset-names = "bcr_rst";
	status = "okay";
};

&qupv3 {
	status = "okay";
	serial@1a84000 {
		bootph-all;
		pinctrl-0 = <&uart1_pins>;
		pinctrl-names = "default";
		qup-se-fw-load = <&uart1_fw>;
		status = "okay";
	};

	uart1_fw: uart_firmware@0 {
		bootph-all;
		compatible = "qcom,ipq5210-geni-uart-fw-v1", "qcom,geni-uart-fw-v1";
		reg = <0 0x01a84000 0 0x4000>;
		status = "okay";
	};

	serial@1a90000 {
		pinctrl-0 = <&uart2_pins>;
		pinctrl-names = "default";
		qup-se-fw-load = <&uart2_fw>;
		status = "okay";
	};

	uart2_fw: uart_firmware@1 {
		compatible = "qcom,ipq5210-geni-uart-fw-v1", "qcom,geni-uart-fw-v1";
		reg = <0 0x01a90000 0 0x4000>;
		status = "okay";
	};

	spi0: spi@1a80000 {
		bootph-all;
		compatible = "qcom-ipq5210-geni-spi";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		clocks = <&gcc GCC_QUPV3_SPI0_CLK>;
		clock-names = "se-spi-clk";
		clock-frequency = <50000000>;
		nor-blk-enable;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		qup-se-fw-load = <&spi0_fw>;

		pinctrl-0 = <&spi0_pinmux>;
		pinctrl-names = "default";

		nor-flash@0 {
			bootph-all;
			compatible = "jedec,spi-nor";
			reg = <0 0 0 0>;
			spi-max-frequency = <50000000>;
		};
	};

	spi0_fw: spi_firmware@0 {
		bootph-all;
		compatible = "qcom,ipq5210-geni-spi-fw-v1",
			     "qcom,geni-spi-fw-v1";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		status = "okay";
	};

	i2c0: i2c@1a88000 {
		compatible = "qcom,ipq5210-geni-i2c", "qcom,geni-i2c";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C0_CLK>;
		assigned-clock-rates = <32000000>;
		clocks = <&gcc GCC_QUPV3_I2C0_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c0_fw>;
		qcom,geni-se-clk-32mhz;
	};

	i2c0_fw: i2c0_firmware@0 {
		compatible = "qcom,ipq5210-geni-i2c-fw-v1",
			     "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		status = "okay";
	};

	i2c1: i2c@1a8c000 {
		compatible = "qcom,ipq5210-geni-i2c", "qcom,geni-i2c";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C1_CLK>;
		assigned-clock-rates = <32000000>;
		clocks = <&gcc GCC_QUPV3_I2C1_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c1_fw>;
		qcom,geni-se-clk-32mhz;
	};

	i2c1_fw: i2c1_firmware@0 {
		compatible = "qcom,ipq5210-geni-i2c-fw-v1",
			     "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		status = "okay";
	};
};
