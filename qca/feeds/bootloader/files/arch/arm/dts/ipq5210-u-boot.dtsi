 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <asm/arch/dt-bindings/clock/qcom,ipq5210-gcc.h>
#include <asm/arch/dt-bindings/reset/qcom,ipq5210-gcc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/net/qcom_ipqsoc.h>
/ {
	bootph-all;

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		uart2 = &uart2;
	};

	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
#ifdef CONFIG_BOOT_BANK_FIXUP
		u-boot,booted-bank = "unknown,bootbank";
#endif
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/delete-node/ smem;
		smem_mem: smem_region@87c00000 {
			bootph-all;
			reg = <0x0 0x87c00000 0x0 0x40000>;
			no-map;
		};

		optee@87d80000 {
			reg = <0x0 0x87d80000 0x0 0x280000>;
			no-map;
		};
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			status = "disabled";
		};
	};

	smem {
		bootph-all;
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc_cx_gpio_reg: soc-cx-gpio-regulator {
		bootph-pre-ram;
		compatible = "qcom,gpio-regulator";
		regulator-name = "soc_cx";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <920000>;
		gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		states = <
			850000 0x0
			920000 0x1
		>;
	};

	voltage_control: voltage-control {
		bootph-pre-ram;
		compatible = "qcom,ipq5210-fuse-voltage-control",
			     "qcom,fuse-voltage-control";

		soc_cx_vc: soc_cx {
			bootph-pre-ram;
			qcom,rail-name = "soc_cx";
			qcom,backend = "gpio";
			qcom,mode = "nominal";
			regulator = <&soc_cx_gpio_reg>;
		};
	};

	soc@0 {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 0x10 0>;

		tlmm: pinctrl@1000000 {
			bootph-all;
			compatible = "qcom,ipq5210-tlmm";
			reg = <0 0x01000000 0 0x300000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&tlmm 0 0 53>;
			interrupt-controller;
			#interrupt-cells = <2>;

			uart1_pins: uart1-state {
				bootph-all;

				rx-pins {
					pins = "gpio38";
					function = "qup_se1_l3";
					drive-strength = <6>;
					bias-pull-down;
					bootph-all;
				};

				tx-pins {
					pins = "gpio39";
					function = "qup_se1_l2";
					drive-strength = <6>;
					bias-pull-down;
					bootph-all;
				};
			};

			uart2_pins: uart2-state {
				tx-pins {
					pins = "gpio40";
					function = "qup_se4_l2";
					drive-strength = <6>;
					bias-pull-down;
					bootph-all;
				};

				rx-pins {
					pins = "gpio41";
					function = "qup_se4_l3";
					drive-strength = <6>;
					bias-pull-down;
					bootph-all;
				};
			};

		};

		intc: interrupt-controller@b000000 {
			bootph-all;
			compatible = "qcom,msm-qgic2";
			interrupt-controller;
			#interrupt-cells = <3>;
			reg = <0 0xb000000 0 0x1000>,  /*GICD*/
				<0 0xb002000 0 0x1000>,  /*GICC*/
				<0 0xb001000 0 0x1000>,  /*GICH*/
				<0 0xb004000 0 0x1000>;  /*GICV*/
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		tmel_qmp: tmel-qmp@32090000 {
			bootph-all;
			compatible = "qcom,tmel-qmp-mbox";
			reg = <0x0 0x32090000 0x0 0x20>,
			      <0x0 0x32091000 0x0 0x20>;
			reg-names = "mcore", "ucore";

			interrupts = <GIC_SPI 73 IRQ_TYPE_EDGE_RISING>;
			max_pkt_size = <0x18>;

			#mbox-cells = <0>;
			status = "disabled";
		};

		tmelcom: qcom,tmelcom {
			bootph-all;
			compatible = "qcom,tmelcom";
			mboxes = <&tmel_qmp>;
			mbox-names = "tmel-qmp-mbox";
			#clock-cells = <1>;
			#power-domain-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		gcc: clock-controller@1800000 {
			bootph-all;
			compatible = "qcom,ipq5210-gcc";
			reg = <0 0x01800000 0 0x40000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		gpll0: pll@1820000 {
			bootph-pre-ram;
			compatible = "qcom,ipq5210-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01820000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll0";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x1>;
			status = "okay";
		};

		gpll2: pll@1821000 {
			bootph-pre-ram;
			compatible = "qcom,ipq5210-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01821000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll2";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x2>;
			status = "okay";
		};

		gpll4: pll@1822000 {
			bootph-pre-ram;
			compatible = "qcom,ipq5210-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01822000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll4";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x4>;
			status = "okay";
		};

		apsspll: pll@b116000 {
			bootph-pre-ram;
			compatible = "qcom,ipq5210-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x0b116000 0 0x1000>;
			clock-output-names = "apsspll";
			status = "okay";
		};

		apss_cpu: apss-cpu-clock@b111000 {
			bootph-pre-ram;
			compatible = "qcom,ipq5210-apss";
			reg = <0 0x0b111000 0 0x1000>;
			#clock-cells = <1>;
		};

		pll_init: qcom,ipq-init-plls {
			bootph-pre-ram;
			compatible = "qcom,ipq-init-plls";
			plls = <&gpll0 &gpll2 &gpll4 &apsspll>;
			status = "okay";
		};

		board_init_clks: qcom,ipq-init-clks {
			bootph-pre-ram;
			compatible = "qcom,ipq-init-clks";

			clocks = <&gcc GCC_APCS_CLOCK_BRANCH_ENA_VOTE>,
				 <&gcc GCC_APSS_DBG_CLK>,
				 <&gcc GCC_APSS_TS_CLK>,
				 <&gcc GCC_SNOC_QOSGEN_EXTREF_CLK>,
				 <&gcc GCC_SYS_NOC_AT_CLK>,
				 <&gcc GCC_SNOC_XO_DCD_CLK>,
				 <&gcc GCC_SNOC_TS_CLK>,
				 <&gcc GCC_PCNOC_AT_CLK>,
				 <&gcc GCC_PCNOC_TS_CLK>,
				 <&gcc GCC_CNOC_QOSGEN_EXTREF_CLK>;

			assigned-clocks = <&apss_cpu APCS_ALIAS0_CLK>,
					  <&gcc GCC_PCNOC_BFDCD_CLK>,
					  <&gcc GCC_SYSTEM_NOC_BFDCD_CLK>,
					  <&gcc GCC_APSS_AXI_CLK>,
					  <&gcc GCC_APSS_AHB_CLK>,
					  <&gcc GCC_QDSS_TSCTR_CLK>,
					  <&gcc GCC_QDSS_AT_CLK>;
			assigned-clock-rates = <1416000000>,
					       <100000000>,
					       <266666666>,
					       <800000000>,
					       <100000000>,
					       <600000000>,
					       <240000000>;

			clock-names = "apcs_branch_vote",
					"pcnoc_bfdcd",
					"sysnoc_bfdcd";

			status = "okay";
		};

		nsscc: clock-controller@39b00000 {
			compatible = "qcom,ipq5210-gcc", "qcom,ipq5210-nsscc";
			reg = <0x0 0x39b00000 0x0 0x100000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		qupv3: geniqup@1ac0000 {
			compatible = "qcom,geni-se-qup";
			reg = <0 0x01ac0000 0 0x2000>;
			clocks = <&gcc GCC_QUPV3_AHB_MST_CLK>,
				 <&gcc GCC_QUPV3_AHB_SLV_CLK>;
			clock-names = "m-ahb", "s-ahb";
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;

			status = "disabled";

			uart1: serial@1a84000 {
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x1a84000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART1_CLK>;
				clock-names = "se";
				status = "disabled";
			};

			uart2: serial@1a90000 {
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x1a90000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART2_CLK>;
				clock-names = "se";
				status = "disabled";
			};
		};

		sdhc: mmc@7804000 {
			compatible = "qcom,ipq5210-sdhci", "qcom,sdhci-msm-v5";
			reg = <0 0x07804000 0 0x1000>, <0 0x07805000 0 0x1000>;
			reg-names = "hc", "cqhci";

			clocks = <&gcc GCC_SDCC1_AHB_CLK>,
				 <&gcc GCC_SDCC1_APPS_CLK>;
			clock-names = "iface", "core";

			status = "disabled";
		};

		qmp_ssphy_0: ssphy@7D000 {
			compatible = "qcom,ipq9574-qmp-usb3-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x7D000 0x0 0x1C4>,
				<0x0 0x7D200 0x0 0x130>,
				<0x0 0x7D400 0x0 0x200>,
				<0x0 0x7D800 0x0 0x1F8>;
			reg-names = "com_base", "tx_base",
				"rx_base", "pcs_base";
			clocks = <&gcc GCC_USB0_PIPE_CLK>;
			#phy-cells = <0>;
			resets =  <&gcc GCC_USB0_PHY_BCR>,
			       <&gcc GCC_USB3PHY_0_PHY_BCR>;
			status = "disabled";
		};

		qusb2_phy_0: qusb2_0@7B000 {
			compatible = "qcom,ipq9574-qusb2-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x07B000 0x0 0x180>;
			#phy-cells = <0>;
			clocks = <&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "cfg_ahb";

			resets = <&gcc GCC_QUSB2_0_PHY_BCR>;
			status = "disabled";
		};

		usb3_0: usb3_0@8af8800 {
			compatible = "qcom,ipq5210-dwc3", "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<24000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "master",
				"aux",
				"sleep",
				"ref",
				"cfg_ahb";
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
				clock-names = "ref";
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>, <&qmp_ssphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				maximum-speed = "super-speed";
			};
		};

		/*
		* usb3_1 node configuration makes usb 3.0 controller
		* to use usb 3.0 devices as usb 2.0 device
		*/
		usb3_1: usb3_1@8af8800 {
			compatible = "qcom,ipq5210-dwc3", "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<24000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "master",
				"aux",
				"sleep",
				"ref",
				"cfg_ahb";
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			qcom,select-utmi-as-pipe-clk;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
				clock-names = "ref";
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		nand: nand-controller@79B0000 {
			bootph-all;
			compatible = "qti,spi-nand-v2.1.3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x79B0000 0x0 0x10000>;
			assigned-clocks = <&gcc GCC_QPIC_CLK>,
					 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			assigned-clock-rates = <100000000>, <200000000>;
			clock-names = "qpic-clk",
				      "qpic-io-macro-clk",
				      "qpic-ahb-clk";
			clocks = <&gcc GCC_QPIC_CLK>,
				<&gcc GCC_QPIC_IO_MACRO_CLK>,
				<&gcc GCC_QPIC_AHB_CLK>;

			bam_reg = <0x07984000>;
			status_pipe = <3>;
			status_pipe_grp = <0>;
			read_pipe = <1>;
			read_pipe_grp = <0>;
			write_pipe = <0>;
			write_pipe_grp = <0>;
			cmd_pipe = <2>;
			cmd_pipe_grp = <1>;
			serial_training;
			pinctrl-0 = <&qspi_pinmux>;
			pinctrl-names = "default";
			status = "okay";
		};

		restart@4ab000 {
			bootph-pre-ram;
			compatible = "qcom,pshold";
			reg = <0x0 0x4AB000 0x0 0x4>;
			status = "okay";
		};

		pcie0_phy: phy@84000 {
			compatible = "qcom,ipq5210-qmp-gen3x1-pcie-phy",
				     "qcom,ipq9574-qmp-gen3x1-pcie-phy";
			reg = <0x0 0x00084000 0x0 0x1bc>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_PCIE0_RCHNG_CLK>,
				 <&gcc GCC_PCIE0_PIPE_CLK>,
				 <&gcc GCC_SNOC_PCIE0_AXI_M_CLK>,
				 <&gcc GCC_CNOC_PCIE0_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"axi_m", "lane_s";

			resets = <&gcc GCC_PCIE0_PHY_BCR>,
				 <&gcc GCC_PCIE0PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie1_phy: phy@f4000 {
			compatible = "qcom,ipq5210-qmp-gen3x2-pcie-phy",
				     "qcom,ipq9574-qmp-gen3x2-pcie-phy";
			reg = <0x0 0x000f4000 0x0 0x1bc>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE1_AUX_CLK>,
				 <&gcc GCC_PCIE1_AHB_CLK>,
				 <&gcc GCC_PCIE1_RCHNG_CLK>,
				 <&gcc GCC_PCIE1_PIPE_CLK>,
				 <&gcc GCC_SNOC_PCIE1_AXI_M_CLK>,
				 <&gcc GCC_CNOC_PCIE1_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"axi_m","lane_s";

			resets = <&gcc GCC_PCIE1_PHY_BCR>,
				 <&gcc GCC_PCIE1PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		/* 1L controller */
		pcie0: pcie@70000000 {
			compatible = "qcom,pcie-ipq5210";
			reg =  <0x0 0x70000000 0x0 0xf1d>,
			       <0x0 0x70000f20 0x0 0xa8>,
			       <0x0 0x70001000 0x0 0x1000>,
			       <0x0 0x80000 0x0 0x3000>,
			       <0x0 0x70100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <0>;
			bus-range = <0x00 0xff>;
			num-lanes = <1>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <0>;

			ranges = <0x81000000 0 0x70200000 0x0 0x70200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x70300000 0x0 0x70300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE0_AXI_M_CLK>,
				 <&gcc GCC_PCIE0_AXI_S_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE0_AUX_CLK>,
					<&gcc GCC_PCIE0_AXI_M_CLK>,
					<&gcc GCC_PCIE0_AXI_S_CLK>,
					<&gcc GCC_PCIE0_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<240000000>,
						<240000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE0_PIPE_ARES>,
				 <&gcc GCC_PCIE0_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AXI_M_ARES>,
				 <&gcc GCC_PCIE0_AXI_S_ARES>,
				 <&gcc GCC_PCIE0_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE0_AHB_ARES>,
				 <&gcc GCC_PCIE0_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie0_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};

		/* 2L controller */
		pcie1: pcie@50000000 {
			compatible = "qcom,pcie-ipq5210";
			reg =  <0x0 0x50000000 0x0 0xf1d>,
			       <0x0 0x50000f20 0x0 0xa8>,
			       <0x0 0x50001000 0x0 0x1000>,
			       <0x0 0xf0000 0x0 0x3000>,
			       <0x0 0x50100000 0x0 0x1000>;
			reg-names = "dbi", "elbi", "atu", "parf", "config";
			device_type = "pci";
			linux,pci-domain = <1>;
			bus-range = <0x00 0xff>;
			num-lanes = <2>;
			#address-cells = <3>;
			#size-cells = <2>;
			axi-halt-val = <0x1e>; /* increase halt window size to 1GB */
			id = <1>;

			ranges = <0x81000000 0 0x50200000 0x0 0x50200000 0 0x00100000>,   /* downstream I/O */
				 <0x82000000 0 0x50300000 0x0 0x50300000 0 0x0fd00000>; /* non-prefetchable memory */

			clocks = <&gcc GCC_PCIE1_AXI_M_CLK>,
				 <&gcc GCC_PCIE1_AXI_S_CLK>,
				 <&gcc GCC_PCIE1_AHB_CLK>,
				 <&gcc GCC_PCIE1_AUX_CLK>,
				 <&gcc GCC_PCIE1_AXI_S_BRIDGE_CLK>;

			clock-names = "axi_m",
				      "axi_s",
				      "ahb",
				      "aux",
				      "axi_bridge";

			assigned-clocks = <&gcc GCC_PCIE1_AUX_CLK>,
					<&gcc GCC_PCIE1_AXI_M_CLK>,
					<&gcc GCC_PCIE1_AXI_S_CLK>,
					<&gcc GCC_PCIE1_RCHNG_CLK>;

			assigned-clock-rates = <20000000>,
						<266666666>,
						<240000000>,
						<100000000>;

			resets = <&gcc GCC_PCIE1_PIPE_ARES>,
				 <&gcc GCC_PCIE1_CORE_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AXI_M_ARES>,
				 <&gcc GCC_PCIE1_AXI_S_ARES>,
				 <&gcc GCC_PCIE1_AXI_M_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AXI_S_STICKY_RESET>,
				 <&gcc GCC_PCIE1_AHB_ARES>,
				 <&gcc GCC_PCIE1_AUX_ARES>;

			reset-names = "pipe",
				      "sticky",
				      "axi_m",
				      "axi_s",
				      "axi_m_sticky",
				      "axi_s_sticky",
				      "ahb",
				      "aux";

			msi-parent = <&intc>;

			phys = <&pcie1_phy>;
			phy-names = "pciephy";

			status = "disabled";
		};

		mdio_ahb: mdio-ahb@1400000 {
			status = "okay";
			compatible = "qcom,mdio-ahb-ipq52xx";
			reg = <0x0 0x1400000 0x0 0x200000>;
			clocks = <&gcc GCC_GEPHY_SYS_CLK>,
				 <&gcc GCC_MDIO_GEPHY_AHB_CLK>;
			clock-names = "gephy_sys_clk",
				      "mdio_ahb_clk";
		};

		mdio: mdio@90000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "qcom,ipq4019-mdio";
			pinctrl-0 = <&mdio_pins>;
			pinctrl-names = "default";
			reg = <0x00000000 0x00090000 0x00000000 0x00000064>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clk_div = /bits/ 8 <15>;
			status = "okay";
		};

		ess_instance: ess-instance {
			compatible = "qcom,ipq-nss-switchv2";
			#address-cells = <1>;
			#size-cells = <1>;
