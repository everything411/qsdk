/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/qcom,ipq5424-gcc.h>
#include <asm/arch/dt-bindings/clock/qcom,ipq5424-gcc.h>
#include <dt-bindings/reset/qcom,ipq5424-gcc.h>
#include <asm/arch/dt-bindings/reset/qcom,ipq5424-gcc.h>
#include <dt-bindings/gpio/gpio.h>
/ {
	bootph-all;
	compatible = "qcom,ipq5424";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &uart1;
	};
	chosen {
		stdout-path = "serial0:115200n8";
	};
	clocks {
		sleep_clk: sleep-clk {
			bootph-all;
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};
		xo_board: xo-board-clk {
			bootph-all;
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
		};
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		smem_mem: smem_region@8a800000 {
			bootph-all;
			reg = <0x0 0x8a800000 0x0 0x32000>;
			no-map;
		};
	};
	smem {
		bootph-all;
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
	};
	soc@0 {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 0x10 0>;

		tlmm: pinctrl@1000000 {
			bootph-all;
			compatible = "qcom,ipq5424-tlmm";
			reg = <0 0x01000000 0 0x300000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&tlmm 0 0 50>;
			interrupt-controller;
			#interrupt-cells = <2>;

			uart1_pins: uart1-state {
				bootph-all;
				pins = "gpio43", "gpio44";
				function = "uart1";
				drive-strength = <8>;
				bias-pull-up;
			};

			sdc_default_state: sdc-default-state {
				bootph-all;
				clk-pins {
					bootph-all;
					pins = "gpio5";
					function = "sdc_clk";
					drive-strength = <8>;
					bias-disable;
				};

				cmd-pins {
					bootph-all;
					pins = "gpio4";
					function = "sdc_cmd";
					drive-strength = <8>;
					bias-pull-up;
				};

				data-pins {
					bootph-all;
					pins = "gpio0", "gpio1", "gpio2", "gpio3";
					function = "sdc_data";
					drive-strength = <8>;
					bias-pull-up;
				};
			};

			spi0_pinmux: spi0 {
				bootph-all;
				spi0_sclk {
					bootph-all;
					pins = "gpio6";
					function = "spi0_clk";
					drive-strength = <8>;
					bias-pull-down;
				};

				spi0_cs0 {
					bootph-all;
					pins = "gpio7";
					function = "spi0_cs";
					drive-strength = <8>;
					bias-pull-up;
				};

				spi0_miso {
					bootph-all;
					pins = "gpio8";
					function = "spi0_miso";
					drive-strength = <8>;
					bias-pull-down;
				};

				spi0_mosi {
					bootph-all;
					pins = "gpio9";
					function = "spi0_mosi";
					drive-strength = <8>;
					bias-pull-down;
				};
			};

			qspi_pinmux: nand {
				bootph-all;
				qspi_data {
					bootph-all;
					pins = "gpio0", "gpio1", "gpio2","gpio3";
					function = "qspi_data";
					drive-strength = <8>;
					bias-pull-up;
				};

				qspi_cs_n {
					bootph-all;
					pins = "gpio4";
					function = "qspi_cs";
					drive-strength = <8>;
					bias-pull-up;
				};

				qspi_clk {
					bootph-all;
					pins = "gpio5";
					function = "qspi_clk";
					drive-strength = <8>;
					bias-disable;
				};
			};
		};

		intc: interrupt-controller@f200000 {
			bootph-all;
			compatible = "arm,gic-v3";
			reg = <0x0 0x0f200000 0x0 0x10000>, /* GICD */
			      <0x0 0x0f240000 0x0 0xa0000>; /* GICR * 5 regions */
			#interrupt-cells = <0x3>;
			interrupt-controller;
			#redistributor-regions = <1>;
			redistributor-stride = <0x0 0x20000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		tmel_qmp: tmel-qmp@32090000 {
			bootph-all;
			compatible = "qcom,tmel-qmp-mbox-secure";
			reg = <0x0 0x32090000 0x0 0x20>,
				<0x0 0x32091000 0x0 0x20>;
			reg-names = "mcore", "ucore";

			interrupts = <GIC_SPI 121 IRQ_TYPE_EDGE_RISING>;
			max_pkt_size = <0x18>;

			#mbox-cells = <0>;
			status = "okay";
		};

		tmelcom: qcom,tmelcom {
			bootph-all;
			compatible = "qcom,tmelcom";
			mboxes = <&tmel_qmp>;
			mbox-names = "tmel-qmp-mbox";
			#clock-cells = <1>;
			#power-domain-cells = <1>;
			#reset-cells = <1>;
			status = "okay";
		};

		nand: nand-controller@79B0000 {
			bootph-all;
			compatible = "qti,spi-nand-v2.1.3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x79B0000 0x0 0x10000>;
			assigned-clocks = <&gcc GCC_QPIC_CLK>,
					 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			assigned-clock-rates = <100000000>, <200000000>;
			max_clk_feaquency = <400000000>;
			clock-names = "qpic-clk",
				      "qpic-io-macro-clk",
				      "qpic-ahb-clk";
			clocks = <&gcc GCC_QPIC_CLK>,
				<&gcc GCC_QPIC_IO_MACRO_CLK>,
				<&gcc GCC_QPIC_AHB_CLK>;
			resets = <&gcc GCC_QPIC_BCR>;
			reset-names = "bcr_rst";

			bam_reg = <0x07984000>;
			status_pipe = <3>;
			status_pipe_grp = <0>;
			read_pipe = <1>;
			read_pipe_grp = <0>;
			write_pipe = <0>;
			write_pipe_grp = <0>;
			cmd_pipe = <2>;
			cmd_pipe_grp = <1>;
			pinctrl-0 = <&qspi_pinmux>;
			pinctrl-names = "default";
			status = "okay";
 		};

		gcc: clock-controller@1800000 {
			bootph-all;
			compatible = "qcom,ipq5424-gcc";
			reg = <0 0x01800000 0 0x40000>;
			clocks = <&xo_board>,
				 <&sleep_clk>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#interconnect-cells = <1>;
		};

		gpll0: pll@1820000 {
			bootph-all;
			compatible = "qcom,ipq5424-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01820000 0 0x1000>;
			clock-output-names = "gpll0";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x1>;
			status = "okay";
		};

		gpll2: pll@1821000 {
			bootph-all;
			compatible = "qcom,ipq5424-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01821000 0 0x1000>;
			clock-output-names = "gpll2";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x2>;
			status = "okay";
		};

		gpll4: pll@1822000 {
			bootph-all;
			compatible = "qcom,ipq5424-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x01822000 0 0x1000>;
			clock-output-names = "gpll4";
			fsm-vote-addr = <0x0180B000>;
			fsm-vote-mask = <0x4>;
			status = "okay";
		};

		apssll: pll@fa80000 {
			bootph-all;
			compatible = "qcom,ipq5424-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x0FA80000 0 0x10000>;
			clock-output-names = "apssll";
			status = "okay";
		};

		l3pll: pll@fa90000 {
			bootph-all;
			compatible = "qcom,ipq5424-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x0FA90000 0 0x10000>;
			clock-output-names = "l3pll";
			status = "okay";
		};

		pll_init: qcom,ipq-init-plls {
			bootph-all;
			compatible = "qcom,ipq-init-plls";
			plls = <&gpll0 &gpll2 &gpll4 &apssll &l3pll>;
			status = "okay";
		};

		board_init_clks: qcom,ipq-init-clks {
			bootph-all;
			compatible = "qcom,ipq-init-clks";

			clocks = <&gcc GCC_APCS_CLOCK_BRANCH_ENA_VOTE>;

			assigned-clocks = <&gcc GCC_PCNOC_BFDCD_CLK>,
					  <&gcc GCC_SYSTEM_NOC_BFDCD_CLK>;
			assigned-clock-rates = <100000000 266666666>;

			clock-names = "apcs_branch_vote",
					"pcnoc_bfdcd",
					"sysnoc_bfdcd";

			status = "okay";
		};

		tcsr_mutex: hwlock@1905000 {
			bootph-all;
			compatible = "qcom,tcsr-mutex";
			reg = <0 0x01905000 0 0x20000>;
			#hwlock-cells = <1>;
		};

		qupv3: geniqup@1ac0000 {
			bootph-all;
			compatible = "qcom,geni-se-qup";
			reg = <0 0x01ac0000 0 0x2000>;
			ranges;
			clocks = <&gcc GCC_QUPV3_2X_CORE_CLK>,
				 <&gcc GCC_QUPV3_AHB_MST_CLK>,
				 <&gcc GCC_QUPV3_AHB_SLV_CLK>,
				 <&gcc GCC_QUPV3_CORE_CLK>,
				 <&gcc GCC_QUPV3_SLEEP_CLK>;
			clock-names = "2x-core", "m-ahb", "s-ahb",
					"core", "sleep";

			#address-cells = <2>;
			#size-cells = <2>;

			uart1: serial@1a84000 {
				bootph-all;
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x01a84000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART1_CLK>;
				clock-names = "se";
				pinctrl-0 = <&uart1_pins>;
				pinctrl-names = "default";
				qup-se-fw-load = <&uart1_fw>;
				status = "okay";
			};

			uart1_fw: uart_firmware@0 {
				bootph-all;
				compatible = "qcom,ipq5424-geni-uart-fw-v1",
					     "qcom,geni-uart-fw-v1";
				reg = <0 0x01a84000 0 0x4000>;
				status = "okay";
			};

			spi0: spi@1a90000 {
				bootph-all;
				compatible = "qcom-ipq5424-geni-spi";
				reg = <0 0x1a90000 0 0x4000>;
				reg-names = "se_phys";
				clocks = <&gcc GCC_QUPV3_SPI0_CLK>;
				clock-names = "se-spi-clk";
				clock-frequency = <50000000>;
				nor-blk-enable;
				status = "okay";
				#address-cells = <1>;
				#size-cells = <0>;
				qup-se-fw-load = <&spi_fw>;

				pinctrl-0 = <&spi0_pinmux>;
				pinctrl-names = "default";

				nor-flash@0 {
					bootph-all;
					compatible = "jedec,spi-nor";
					reg = <0>;
					spi-max-frequency = <50000000>;
				};
			};

			spi_fw: spi_firmware@0 {
				bootph-all;
				compatible = "qcom,ipq5424-geni-spi-fw-v1",
					     "qcom,geni-spi-fw-v1";
				reg = <0 0x1a90000 0 0x4000>;
				reg-names = "se_phys";
			};
		};

		sdhc: mmc@7804000 {
			bootph-all;
			compatible = "qcom,ipq5424-sdhci", "qcom,sdhci-msm-v5";
			reg = <0 0x07804000 0 0x1000>, <0 0x07805000 0 0x1000>;
			reg-names = "hc", "cqhci";
			clocks = <&gcc GCC_SDCC1_AHB_CLK>,
				 <&gcc GCC_SDCC1_APPS_CLK>,
				 <&xo_board>;
			clock-names = "iface", "core", "xo";
			bus-width = <4>;
			max-frequency = <192000000>;
			mmc-ddr-1_8v;
			non-removable;
			pinctrl-0 = <&sdc_default_state>;
			pinctrl-names = "default";
			sdhci-caps-mask = <0x0 0x04000000>;
			sdhci-caps = <0x0 0x04000000>;
			resets = <&gcc GCC_SDCC_BCR>;
			reset-names = "bcr_rst";
			status = "okay";
		};
	};
};
