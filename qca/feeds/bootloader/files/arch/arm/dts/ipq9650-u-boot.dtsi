			port_scheduler_resource {
				port@0 {
					port_id = <0>;
					ucast_queue = <128 255>;
					mcast_queue = <256 263>;
					l0sp = <26 41>;
					l0cdrr = <128 255>;
					l0edrr = <128 255>;
					l1cdrr = <26 41>;
					l1edrr = <26 41>;
				};
				port@1 {
