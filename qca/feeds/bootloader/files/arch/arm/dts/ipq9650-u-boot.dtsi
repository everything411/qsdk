#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <asm/arch/dt-bindings/clock/qcom,ipq9650-gcc.h>
#include <asm/arch/dt-bindings/clock/qcom,ipq9650-cmn-pll.h>
#include <asm/arch/dt-bindings/reset/qcom,ipq9650-gcc.h>
#include <dt-bindings/net/qcom_ipqsoc.h>
#include <dt-bindings/gpio/gpio.h>
/ {
	bootph-all;
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &uart1;
		uart2 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
#ifdef CONFIG_BOOT_BANK_FIXUP
		u-boot,booted-bank = "unknown,bootbank";
#endif
	};

	clocks {
		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};

		xo_clk: xo-clk {
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
			#clock-cells = <0>;
		};

		ref_48mhz_clk: ref-48mhz-clk {
			compatible = "fixed-clock";
			clock-frequency = <48000000>;
			#clock-cells = <0>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/delete-node/ smem;
		smem_mem: smem_region@8a500000 {
			bootph-all;
			reg = <0x0 0x8a500000 0x0 0x40000>;
			no-map;
		};

		tfa: tfa_region@0x8a600000 {
			reg = <0x0 0x8a600000 0x0 0x80000>;
			no-map;
		};

		optee: optee_region@0x8a680000 {
			reg = <0x0 0x8a680000 0x0 0x280000>;
			no-map;
		};
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			status = "disabled";
		};
	};

	smem {
		bootph-all;
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc@0 {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 0x10 0>;

		tlmm: pinctrl@1000000 {
			bootph-all;
			compatible = "qcom,ipq9650-tlmm";
			reg = <0 0x01000000 0 0x300000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&tlmm 0 0 54>;
			interrupt-controller;
			#interrupt-cells = <2>;

			uart1_pins: uart1-state {
				bootph-all;
				rx-pins {
					pins = "gpio43";
					function = "qup_se6_l3";
					drive-strength = <8>;
					bias-pull-down;
					bootph-all;
				};

				tx-pins {
					pins = "gpio44";
					function = "qup_se6_l2";
					drive-strength = <8>;
					bias-pull-down;
					output-high;
					bootph-all;
				};
			};

			uart2_pins: uart2-state {
				rx-pins {
					pins = "gpio12";
					function = "qup_se1_l3";
					drive-strength = <8>;
					bias-pull-down;
				};

				tx-pins {
					pins = "gpio11";
					function = "qup_se1_l0";
					drive-strength = <8>;
					bias-pull-down;
					output-high;
				};
			};
		};

		intc: interrupt-controller@f200000 {
			bootph-all;
			compatible = "arm,gic-v3";
			reg = <0x0 0x0f200000 0x0 0x10000>, /* GICD */
			      <0x0 0x0f240000 0x0 0xa0000>; /* GICR * 5 regions */
			#interrupt-cells = <0x3>;
			interrupt-controller;
			#redistributor-regions = <1>;
			redistributor-stride = <0x0 0x20000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		tmel_qmp: tmel-qmp@22090000 {
			bootph-all;
			compatible = "qcom,tmel-qmp-mbox";
			reg = <0x0 0x22090000 0x0 0x20>,
			      <0x0 0x22091000 0x0 0x20>;
			reg-names = "mcore", "ucore";

			interrupts = <GIC_SPI 126 IRQ_TYPE_EDGE_RISING>;
			max_pkt_size = <0x18>;

			#mbox-cells = <0>;
			status = "disabled";
		};

		tmelcom: qcom,tmelcom {
			bootph-all;
			compatible = "qcom,tmelcom";
			mboxes = <&tmel_qmp>;
			mbox-names = "tmel-qmp-mbox";
			#clock-cells = <1>;
			#power-domain-cells = <1>;
			#reset-cells = <1>;
			status = "disabled";
		};

		gcc: clock-controller@1800000 {
			bootph-all;
			compatible = "qcom,ipq9650-gcc";
			reg = <0 0x01800000 0 0x40000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		gpll0: pll@1820000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-clk-pll",
				     "qcom,ipq-clk-pll";
			reg = <0 0x01820000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll0";
			status = "okay";
		};

		gpll2: pll@1821000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-clk-pll",
				     "qcom,ipq-clk-pll";
			reg = <0 0x01821000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll2";
			status = "okay";
		};

		gpll4: pll@1822000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-clk-pll",
				     "qcom,ipq-clk-pll";
			reg = <0 0x01822000 0 0x1000>;
			#clock-cells = <0>;
			clock-output-names = "gpll4";
			status = "okay";
		};

		apsspll: pll@fa80000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x0fa80000 0 0x10000>;
			clock-output-names = "apsspll";
			status = "okay";
		};

		apss_cpu: apss-cpu-clock@fa80000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-apss";
			reg = <0 0x0fa80000 0 0x10000>;
			#clock-cells = <1>;
		};

		l3pll: pll@faa0000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-clk-pll",
					"qcom,ipq-clk-pll";
			reg = <0 0x0faa0000 0 0x10000>;
			clock-output-names = "l3pll";
			status = "okay";
		};

		apss_l3: apss-l3-clock@faa0000 {
			bootph-pre-ram;
			compatible = "qcom,ipq9650-apss";
			reg = <0 0x0faa0000 0 0x10000>;
			#clock-cells = <1>;
		};

		pll_init: qcom,ipq-init-plls {
			bootph-pre-ram;
			compatible = "qcom,ipq-init-plls";
			plls = <&gpll0 &gpll2 &gpll4 &apsspll &l3pll>;
			status = "okay";
		};

		board_init_clks: qcom,ipq-init-clks {
			bootph-pre-ram;
			compatible = "qcom,ipq-init-clks";

			clocks = <&gcc GCC_MPM_AHB_CLK>,
				 <&gcc GCC_GEMNOC_ANOC_CLK>,
				 <&gcc GCC_ANOC0_AXI_CLK>,
				 <&gcc GCC_APSS_DBG_CLK>,
				 <&gcc GCC_APSS_TS_CLK>,
				 <&gcc GCC_SNOC_QOSGEN_EXTREF_CLK>,
				 <&gcc GCC_SYS_NOC_AT_CLK>,
				 <&gcc GCC_SNOC_XO_DCD_CLK>,
				 <&gcc GCC_SNOC_TS_CLK>,
				 <&gcc GCC_PCNOC_AT_CLK>,
				 <&gcc GCC_PCNOC_TS_CLK>,
				 <&gcc GCC_CNOC_QOSGEN_EXTREF_CLK>,
				 <&gcc GCC_AGGRNOC_ATB_CLK>,
				 <&gcc GCC_AGGRNOC_TS_CLK>,
				 <&gcc GCC_ANOC1_AXI_CLK>,
				 <&gcc GCC_ANOC_QOSGEN_EXTREF_CLK>,
				 <&gcc GCC_ANOC_XO_DCD_CLK>,
				 <&gcc GCC_PCNOC_CE_EDPD_CLK>,
				 <&gcc GCC_CMN_LDO_CLK>,
				 <&gcc GCC_SPDM_PCNOC_CY_CLK>;

			assigned-clocks = <&apss_cpu APSS_SILVER_CLK>,
					  <&apss_l3 APSS_L3_CLK>,
					  <&gcc GCC_PCNOC_BFDCD_CLK>,
					  <&gcc GCC_SYSTEM_NOC_BFDCD_CLK>,
					  <&gcc GCC_APSS_AXI_CLK>,
					  <&gcc GCC_APSS_AHB_CLK>,
					  <&gcc GCC_QDSS_TSCTR_CLK>,
					  <&gcc GCC_QDSS_AT_CLK>,
					  <&gcc GCC_ANOC0_AXI_BFDCD_CLK>,
					  <&gcc GCC_XO_CLK>;

			assigned-clock-rates = <1368000000>,
					       <1176000000>,
					       <100000000>,
					       <266666666>,
					       <800000000>,
					       <100000000>,
					       <600000000>,
					       <240000000>,
					       <342000000>,
					       <24000000>;

			clock-names = "pcnoc_bfdcd",
				      "sysnoc_bfdcd",
				      "apss_axi",
				      "apss_ahb",
				      "qdss_tsctr",
				      "qdss_at",
				      "anoc_axi_bfdcd",
				      "xo";

			status = "okay";
		};

		nsscc: clock-controller@29b00000 {
			compatible = "qcom,ipq9650-nsscc";
			reg = <0x0 0x29b00000 0x0 0x100000>;
			clocks = <&xo_clk>,
				 <&cmn_pll IPQ9650_NSS_CLK>,
				 <&cmn_pll IPQ9650_PPE_CLK>;
			clock-names = "xo",
				      "nss",
				      "ppe";
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
		};

		qupv3: geniqup@1ac0000 {
			bootph-all;
			compatible = "qcom,geni-se-qup";
			reg = <0 0x01ac0000 0 0x2000>;
			clocks = <&gcc GCC_QUPV3_AHB_MST_CLK>,
				 <&gcc GCC_QUPV3_AHB_SLV_CLK>;
			clock-names = "m-ahb", "s-ahb";
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;

			status = "disabled";

			uart1: serial@1a98000 {
				bootph-all;
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x1a98000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART2_CLK>;
				clock-names = "se";
				status = "disabled";
			};

			uart2: serial@1a84000 {
				compatible = "qcom,geni-debug-uart";
				reg = <0 0x1a84000 0 0x4000>;
				clocks = <&gcc GCC_QUPV3_UART1_CLK>;
				clock-names = "se";
				status = "disabled";
			};
		};

		sdhc: mmc@7804000 {
			bootph-all;
			compatible = "qcom,ipq9650-sdhci", "qcom,sdhci-msm-v5";
			reg = <0 0x07804000 0 0x1000>,
			      <0 0x07805000 0 0x1000>,
			      <0 0x07808000 0 0x8000>;
			reg-names = "hc", "cqhci", "ice";

			clocks = <&gcc GCC_SDCC1_AHB_CLK>,
				 <&gcc GCC_SDCC1_APPS_CLK>,
				 <&gcc GCC_SDCC1_ICE_CORE_CLK>;
			clock-names = "iface", "core", "ice";

			status = "disabled";
		};

		nand: nand-controller@79B0000 {
			bootph-all;
			compatible = "qti,spi-nand-v2.1.3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x79B0000 0x0 0x10000>;
			assigned-clocks = <&gcc GCC_QPIC_CLK>,
					 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			assigned-clock-rates = <100000000>, <200000000>;
			clock-names = "qpic-clk",
				      "qpic-io-macro-clk",
				      "qpic-ahb-clk";
			clocks = <&gcc GCC_QPIC_CLK>,
				<&gcc GCC_QPIC_IO_MACRO_CLK>,
				<&gcc GCC_QPIC_AHB_CLK>;

			bam_reg = <0x07984000>;
			status_pipe = <3>;
			status_pipe_grp = <0>;
			read_pipe = <1>;
			read_pipe_grp = <0>;
			write_pipe = <0>;
			write_pipe_grp = <0>;
			cmd_pipe = <2>;
			cmd_pipe_grp = <1>;
			serial_training;
			pinctrl-0 = <&qspi_pinmux>;
			pinctrl-names = "default";
			status = "okay";
		};

		qmp_ssphy_0: ssphy@7d000 {
			compatible = "qcom,ipq9650-qmp-usb3-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x7d000 0x0 0x1c0>,
				<0x0 0x7d200 0x0 0x170>,
				<0x0 0x7d400 0x0 0x200>,
				<0x0 0x7d800 0x0 0x1f0>,
				<0x0 0x7de00 0x0 0x60>;
			reg-names = "com_base", "tx_base",
				"rx_base", "pcs_base", "pcs_usb_base";
			clocks = <&gcc GCC_USB0_AUX_CLK>,
				 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				 <&gcc GCC_USB0_PIPE_CLK>;
			#phy-cells = <0>;
			resets =  <&gcc GCC_USB0_PHY_BCR>,
			       <&gcc GCC_USB3PHY_0_PHY_BCR>;
			status = "disabled";
		};

		qusb2_phy_0: qusb2_0@7b000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x07b000 0x0 0x114>;
			#phy-cells = <0>;
			clocks = <&gcc GCC_USB0_PHY_CFG_AHB_CLK>;
			clock-names = "cfg_ahb";

			resets = <&gcc GCC_QUSB2_0_PHY_BCR>;
			status = "disabled";
		};

		qusb2_phy_1: qusb2_1@71000 {
			compatible = "qcom,ipq9650-usb-hs-phy";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x071000 0x0 0x114>;
			#phy-cells = <0>;
			clocks = <&gcc GCC_USB1_PHY_CFG_AHB_CLK>;
			clock-names = "cfg_ahb";
			resets = <&gcc GCC_QUSB2_1_PHY_BCR>;
			status = "disabled";
		};

		usb3_0: usb3_0@8af8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<24000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				<&gcc GCC_USB_CMN_HCLK>,
				<&gcc GCC_USB_CMN_LDO_CLK>;
			clock-names = "master",
				"aux",
				"sleep",
				"ref",
				"cfg_ahb",
				"cmn_hclk",
				"cmn_ldo";
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				clocks = <&gcc GCC_USB0_MOCK_UTMI_CLK>;
				clock-names = "ref";
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>, <&qmp_ssphy_0>;
				phy-names = "usb2-phy", "usb3-phy";
				maximum-speed = "super-speed";
			};
		};

		/*
		* usb3_1 node configuration makes usb 3.0 controller
		* to use usb 3.0 devices as usb 2.0 device
		*/
		usb3_1: usb3_1@8af8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x8af8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_AUX_CLK>;
			assigned-clock-rates = <200000000>,
				<24000000>,
				<24000000>;
			clocks = <&gcc GCC_USB0_MASTER_CLK>,
				<&gcc GCC_USB0_AUX_CLK>,
				<&gcc GCC_USB0_SLEEP_CLK>,
				<&gcc GCC_USB0_MOCK_UTMI_CLK>,
				<&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
				<&gcc GCC_USB_CMN_HCLK>,
				<&gcc GCC_USB_CMN_LDO_CLK>;
                        clock-names = "master",
                                "aux",
                                "sleep",
                                "ref",
                                "cfg_ahb",
                                "cmn_hclk",
                                "cmn_ldo";
			resets = <&gcc GCC_USB_BCR>;
			ranges;
			qcom,select-utmi-as-pipe-clk;
			status = "disabled";

			dwc3@8a00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x8a00000 0x0 0xf8000>;
				clocks = <&gcc GCC_USB1_MOCK_UTMI_CLK>;
				clock-names = "ref";
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_0>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		usb2_0: usb2_0@1ef8800 {
			compatible = "qcom,dwc3";
			reg = <0x0 0x1ef8800 0x0 0x100>;
			#address-cells = <2>;
			#size-cells = <2>;
			assigned-clocks = <&gcc GCC_USB1_MOCK_UTMI_CLK>;
			assigned-clock-rates = <60000000>;
			clocks = <&gcc GCC_USB1_MASTER_CLK>,
				<&gcc GCC_SNOC_USB_CLK>,
				<&gcc GCC_USB1_SLEEP_CLK>,
				<&gcc GCC_USB1_MOCK_UTMI_CLK>,
				<&gcc GCC_USB1_PHY_CFG_AHB_CLK>;
			clock-names = "master",
				"snoc",
				"sleep",
				"ref",
				"cfg_ahb";
			resets = <&gcc GCC_USB1_BCR>;
			ranges;
			qcom,select-utmi-as-pipe-clk;
			status = "disabled";

			dwc3@1e00000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x1e00000 0x0 0xf8000>;
				clocks = <&gcc GCC_USB1_MOCK_UTMI_CLK>;
				clock-names = "ref";
				dr_mode = "host";
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				phys = <&qusb2_phy_1>;
				phy-names = "usb2-phy";
				maximum-speed = "high-speed";
			};
		};

		pcie0_phy: phy@84000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x0 0x00084000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE0_AUX_CLK>,
				 <&gcc GCC_PCIE0_AHB_CLK>,
				 <&gcc GCC_PCIE0_RCHNG_CLK>,
				 <&gcc GCC_PCIE0_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE0_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE0_PHY_BCR>,
				 <&gcc GCC_PCIE0PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie4_phy: phy@8c000 {
			compatible = "qcom,ipq9650-qmp-gen3x1-pcie-phy";
			reg = <0x0 0x0008c000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE4_AUX_CLK>,
				 <&gcc GCC_PCIE4_AHB_CLK>,
				 <&gcc GCC_PCIE4_RCHNG_CLK>,
				 <&gcc GCC_PCIE4_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE4_1LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE4_PHY_BCR>,
				 <&gcc GCC_PCIE4PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

		pcie3_phy: phy@b4000 {
			compatible = "qcom,ipq9650-qmp-gen3x2-pcie-phy";
			reg = <0x0 0x000b4000 0x0 0x1c0>; /* Serdes PLL */
			#address-cells = <1>;
			#size-cells = <1>;

			clocks = <&gcc GCC_PCIE3_AUX_CLK>,
				 <&gcc GCC_PCIE3_AHB_CLK>,
				 <&gcc GCC_PCIE3_RCHNG_CLK>,
				 <&gcc GCC_PCIE3_PIPE_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_M_CLK>,
				 <&gcc GCC_ANOC_PCIE3_2LANE_S_CLK>;
			clock-names = "aux", "cfg_ahb", "rchng", "pipe",
					"lane_m", "lane_s";

			resets = <&gcc GCC_PCIE3_PHY_BCR>,
				 <&gcc GCC_PCIE3PHY_PHY_BCR>;
			reset-names = "phy", "common";

			#phy-cells = <0>;
			status = "disabled";
		};

