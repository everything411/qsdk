					mcast_queue = <296 297>;
					l0sp = <18 19>;
					l0cdrr = <72 79>;
					l0edrr = <72 79>;
					l1cdrr = <18 19>;
					l1edrr = <18 19>;
				};
				port@8 {
					port_id = <8>;
					ucast_queue = <80 127>;
					mcast_queue = <298 299>;
					l0sp = <20 25>;
					l0cdrr = <80 127>;
					l0edrr = <80 127>;
					l1cdrr = <20 25>;
					l1edrr = <20 25>;
				};
				reserved {
					ucast_queue = <0 0>;
					mcast_queue = <0 0>;
					l0sp = <42 63>;
					l0cdrr = <0 0>;
					l0edrr = <0 0>;
					l1cdrr = <42 63>;
					l1edrr = <42 63>;
				};
			};

			port_scheduler_config {
				port@0 {
					port_id = <0>;

					l1scheduler {
						group@0 {
							/* L0 SP */
							sp = <26>;
							sp_loop_pri = <12>;
							sp_max_pri = <1>;
							/* cpri cdrr epri edrr */
							cfg = <0 26 0 26>;
						};

						group@1 {
							/* SSID groups with 4 priorities on L1 */
							sp = <38>;
							sp_loop_pri = <4>;
							/* cpri cdrr epri edrr */
							cfg = <0 38 0 38>;
						};

						group@2 {
							sp = <42>;
							sp_loop_pri = <3>;
							/* cpri cdrr epri edrr */
							cfg = <0 42 0 42>;
						};
					};

					l0scheduler {
						group@0 {
							/* (5 cores + 4 VPs) + 1 SMD host groups with 8 priorities */
							ucast_queue = <128>;
							ucast_loop_pri = <80>;
							ucast_max_pri = <8>;
							/* multicast queue */
							mcast_queue = <256>;
							mcast_loop_pri = <8>;
							/* sp cpri cdrr epri edrr */
							cfg = <26 0 128 0 128>;
						};

						group@1 {
							/* GRO group */
							ucast_queue = <208>;
							ucast_loop_pri = <8>;
							cfg = <36 0 208 0 208>;
						};

						group@2 {
							/* SMD DS group */
							ucast_queue = <216>;
							ucast_loop_pri = <8>;
							cfg = <37 0 216 0 216>;
						};

						group@3 {
							/* 4 SSID groups with 8 priorities. */
							ucast_queue = <224>;
							ucast_loop_pri = <32>;
							ucast_max_pri = <8>;
							cfg = <38 0 224 0 224>;
						};

						group@4 {
							/* IGSRAM for DDRQ LAN to WAN with 8 priorities. */
							ucast_queue = <216>;
							ucast_loop_pri = <8>;
							ucast_max_pri = <8>;
							cfg = <42 0 216 0 216>;
						};

						group@5 {
							/* IGSRAM for DDRQ WAN to LAN with 8 priorities. */
							ucast_queue = <224>;
							ucast_loop_pri = <8>;
							ucast_max_pri = <8>;
							cfg = <43 0 224 0 224>;
						};

						group@6 {
							/* IGSRAM for DDRQ DS to WAN with 1 priority. */
							ucast_queue = <232>;
							cfg = <44 0 232 0 232>;
						};
					};
				};
				port@1 {
					port_id = <1>;
					l1scheduler {
						group@0 {
							sp = <0>;
							cfg = <0 0 0 0>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <0>;
							ucast_loop_pri = <8>;
							mcast_queue = <272>;
							mcast_loop_pri = <4>;
							cfg = <0 0 0 0 0>;
						};
					};
				};
				port@2 {
					port_id = <2>;
					l1scheduler {
						group@0 {
							sp = <2>;
							cfg = <0 2 0 2>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <8>;
							ucast_loop_pri = <8>;
							mcast_queue = <276>;
							mcast_loop_pri = <4>;
							cfg = <2 0 8 0 8>;
						};
					};
				};
				port@3 {
					port_id = <3>;
					l1scheduler {
						group@0 {
							sp = <4>;
							cfg = <0 4 0 4>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <16>;
							ucast_loop_pri = <8>;
							mcast_queue = <280>;
							mcast_loop_pri = <4>;
							cfg = <4 0 16 0 16>;
						};
					};
				};
				port@4 {
					port_id = <4>;
					l1scheduler {
						group@0 {
							sp = <6>;
							cfg = <0 6 0 6>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <24>;
							ucast_loop_pri = <8>;
							mcast_queue = <284>;
							mcast_loop_pri = <4>;
							cfg = <6 0 24 0 24>;
						};
					};
				};
				port@5 {
					port_id = <5>;
					l1scheduler {
						group@0 {
							sp = <8>;
							cfg = <0 8 0 8>;
						};
					};
					l0scheduler {
						group@0 {
							ucast_queue = <32>;
							ucast_loop_pri = <8>;
							mcast_queue = <288>;
							mcast_loop_pri = <4>;
							cfg = <8 0 32 0 32>;
						};
					};
				};
				port@6 {
					port_id = <6>;

					l1scheduler {
						group@0 {
							sp = <10>;
							sp_loop_pri = <4>;
							sp_max_pri = <1>;
							cfg = <0 10 0 10>;
						};
					};

					l0scheduler {
						group@0 {
							ucast_queue = <40>;
							ucast_loop_pri = <32>;
							ucast_max_pri = <8>;
							mcast_queue = <292>;
							mcast_loop_pri = <4>;
							cfg = <10 0 40 0 40>;
						};
					};
				};

				port@7 {
					port_id = <7>;

					l1scheduler {
						group@0 {
							sp = <18>;
							cfg = <0 18 0 18>;
						};
					};

					l0scheduler {
						group@0 {
							ucast_queue = <72>;
							ucast_loop_pri = <8>;
							mcast_queue = <296>;
							mcast_loop_pri = <2>;
							cfg = <18 0 72 0 72>;
						};
					};
				};

				port@8 {
					port_id = <8>;

					l1scheduler {
						group@0 {
							sp = <20>;
							sp_loop_pri = <6>;
							sp_max_pri = <1>;
							cfg = <0 20 0 20>;
						};
					};

					l0scheduler {
						group@0 {
							ucast_queue = <80>;
							ucast_loop_pri = <48>;
							ucast_max_pri = <8>;
							mcast_queue = <298>;
							mcast_loop_pri = <2>;
							cfg = <20 0 80 0 80>;
						};
					};
				};
			};
		};
	};
};

&tlmm {
	uart1_pins: uart1-state {
		bootph-all;
	};

	sdc_default_state: sdc-default-state {
		bootph-all;
		clk-pins {
			bootph-all;
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			bootph-all;
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			bootph-all;
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi0_pinmux: spi0 {
		bootph-all;
		spi0_sclk {
			bootph-all;
			pins = "gpio6";
			function = "qup_se0_l2";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_cs0 {
			bootph-all;
			pins = "gpio7";
			function = "qup_se0_l3";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_miso {
			bootph-all;
			pins = "gpio8";
			function = "qup_se0_l0";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_mosi {
			bootph-all;
			pins = "gpio9";
			function = "qup_se0_l1";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qspi_pinmux: nand {
		bootph-all;
		qspi_data {
			bootph-all;
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_cs_n {
			bootph-all;
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_clk {
			bootph-all;
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
	};

	mdio_pins: mdio-state {
		mux_0 {
			pins = "gpio22";
			function = "mdc_mst";
			drive-strength = <8>;
			bias-pull-up;
		};

		mux_1 {
			pins = "gpio23";
			function = "mdio_mst";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&sdhc {
	bootph-all;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	sdhci-caps-mask = <0x0 0x04000000>;
	sdhci-caps = <0x0 0x04000000>;
	resets = <&gcc GCC_SDCC_BCR>;
	reset-names = "bcr_rst";
	status = "okay";
};

&qupv3 {
	bootph-all;
	status = "okay";
	uart1: serial@1a98000 {
		bootph-all;
		pinctrl-0 = <&uart1_pins>;
		pinctrl-names = "default";
		qup-se-fw-load = <&uart1_fw>;
		status = "okay";
	};

	uart1_fw: uart_firmware@0 {
		bootph-all;
		compatible = "qcom,ipq9650-geni-uart-fw-v1", "qcom,geni-uart-fw-v1";
		reg = <0 0x01a98000 0 0x4000>;
		status = "okay";
	};

	uart2: serial@1a84000 {
		pinctrl-0 = <&uart2_pins>;
		pinctrl-names = "default";
		qup-se-fw-load = <&uart2_fw>;
		status = "disabled";
	};

	uart2_fw: uart_firmware@1 {
		compatible = "qcom,ipq9650-geni-uart-fw-v1", "qcom,geni-uart-fw-v1";
		reg = <0 0x01a84000 0 0x4000>;
		status = "okay";
	};

	spi0: spi@1a80000 {
		bootph-all;
		compatible = "qcom-ipq9650-geni-spi", "qcom-ipq5424-geni-spi";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		clocks = <&gcc GCC_QUPV3_SPI0_CLK>;
		clock-names = "se-spi-clk";
		clock-frequency = <50000000>;
		nor-blk-enable;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		qup-se-fw-load = <&spi0_fw>;
		tx-fifo-depth = <32>;

		pinctrl-0 = <&spi0_pinmux>;
		pinctrl-names = "default";

		nor-flash@0 {
			bootph-all;
			compatible = "jedec,spi-nor";
			reg = <0>;
			spi-max-frequency = <50000000>;
		};
	};

	spi0_fw: spi_firmware@0 {
		bootph-all;
		compatible = "qcom,ipq9650-geni-spi-fw-v1", "qcom,geni-spi-fw-v1";
		reg = <0 0x1a80000 0 0x4000>;
		reg-names = "se_phys";
		status = "okay";
	};

	i2c0: i2c@1a88000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE2_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE2_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c0_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";
	};

	i2c0_fw: i2c0_firmware@0 {
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		status = "okay";
	};

	i2c2: i2c@1A84000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1A84000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE1_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE1_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c2_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";
	};

	i2c2_fw: i2c2_firmware@0 {
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1A84000 0x0 0x4000>;
		status = "okay";
	};

	i2c1: i2c@1a8c000 {
		bootph-all;
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		reg-names = "se_phys";
		#address-cells = <1>;
		#size-cells = <0>;
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE3_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE3_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c1_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";

		mp8899_pmic: pmic@68 {
			compatible = "mps,mp8899";
			reg = <0x68>;
			bootph-pre-ram;

			regulators {
				bootph-pre-ram;

				soc_cx_pmic: buck3 {
					regulator-name = "buck3";
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <820000>;
					status = "disabled";
					bootph-pre-ram;
				};
			};
		};
	};

	i2c1_fw: i2c1_firmware@0 {
		bootph-all;
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		status = "okay";
	};

	i2c3: i2c@1a90000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a90000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C_SE4_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C_SE4_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c3_fw>;
		qcom,geni-se-clk-32mhz;
		status = "disabled";
	};

	i2c3_fw: i2c3_firmware@0 {
		compatible = "qcom,ipq9650-geni-i2c-fw-v1", "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a90000 0x0 0x4000>;
		status = "okay";
	};
};

/ {
	soc_cx_gpio_reg: soc-cx-gpio-regulator {
		compatible = "qcom,gpio-regulator";
		regulator-name = "soc_cx";
		regulator-min-microvolt = <750000>;
		regulator-max-microvolt = <820000>;
		gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		states = <
			750000 0x0
			820000 0x1
		>;
		status = "disabled";
		bootph-pre-ram;
	};

	ddr_cx_gpio_reg: ddr-cx-gpio-regulator {
		compatible = "qcom,gpio-regulator";
		regulator-name = "ddr_cx";
		regulator-min-microvolt = <750000>;
		regulator-max-microvolt = <960000>;
		gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>,
			<&tlmm 34 GPIO_ACTIVE_HIGH>;
		states = <
			750000 0x0
			815000 0x1
			890000 0x2
			960000 0x3
		>;
		status = "disabled";
		bootph-pre-ram;
	};

	voltage_control: voltage-control {
		compatible = "qcom,ipq9650-fuse-voltage-control",
			     "qcom,fuse-voltage-control";
		bootph-pre-ram;

		soc_cx_vc: soc_cx {
			qcom,rail-name = "soc_cx";
			qcom,backend = "gpio";
			qcom,mode = "nominal";
			regulator = <&soc_cx_gpio_reg>;
			status = "disabled";
			bootph-pre-ram;
		};

		ddr_cx_vc: ddr_cx {
			qcom,rail-name = "ddr_cx";
			qcom,backend = "gpio";
			qcom,mode = "turbo";
			regulator = <&ddr_cx_gpio_reg>;
			status = "disabled";
			bootph-pre-ram;
		};
	};
};
