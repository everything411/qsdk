		watchdog: non-sec@f410000 {
			compatible = "qcom,apss-wdt-ipq9650", "qcom,kpss-wdt";
			#address-cells = <2>;
			#size-cells = <2>;
			reg =  <0x0 0xf410000 0x0 0x1000>;
			clocks = <&sleep_clk>;
			timeout-sec = <30>;
			status = "okay";
		};

		restart@4ab000 {
			bootph-pre-ram;
			compatible = "qcom,pshold";
			reg = <0x0 0x4AB000 0x0 0x4>;
			status = "okay";
		};

		mdio: mdio@90000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "qcom,ipq4019-mdio";
			pinctrl-0 = <&mdio_pins>;
			pinctrl-names = "default";
			reg = <0x00000000 0x00090000 0x00000000 0x00000064>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clk_div = /bits/ 8 <31>;
			status = "okay";
		};

		cmn_pll: clock-controller@9b000 {
			compatible = "qcom,ipq9650-cmn-pll";
			reg = <0x0 0x0009b000 0x0 0x800>;
			clocks = <&ref_48mhz_clk>,
				 <&gcc GCC_CMN_12GPLL_AHB_CLK>,
				 <&gcc GCC_CMN_12GPLL_SYS_CLK>;
			clock-names = "ref", "ahb", "sys";
			#clock-cells = <1>;
			assigned-clocks = <&cmn_pll IPQ9650_CMN_PLL_CLK>;
			assigned-clock-rates-u64 = /bits/ 64 <12000000000>;
			status = "disabled";
		};

