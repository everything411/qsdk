/ {

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {

		/delete-node/ smem;
		smem_mem: smem_region@8a800000 {
			reg = <0x0 0x8a800000 0x0 0x32000>;
			no-map;
		};

		atf@8a832000 {
			reg = <0x0 0x8a832000 0x0 0x80000>;
			no-map;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
	};

	soc@0 {
		nand: nand-controller@79B0000 {
			compatible = "qti,spi-nand-v2.1.3";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x79B0000 0x0 0x10000>;
			assigned-clocks = <&gcc GCC_QPIC_CLK>,
					 <&gcc GCC_QPIC_IO_MACRO_CLK>;
			assigned-clock-rates = <100000000>, <200000000>;
			max_clk_frequency = <400000000>;
			clock-names = "qpic-clk",
				      "qpic-io-macro-clk",
				      "qpic-ahb-clk";
			clocks = <&gcc GCC_QPIC_CLK>,
				<&gcc GCC_QPIC_IO_MACRO_CLK>,
				<&gcc GCC_QPIC_AHB_CLK>;

			bam_reg = <0x07984000>;
			status_pipe = <3>;
			status_pipe_grp = <0>;
			read_pipe = <1>;
			read_pipe_grp = <0>;
			write_pipe = <0>;
			write_pipe_grp = <0>;
			cmd_pipe = <2>;
			cmd_pipe_grp = <1>;
			serial_training;
			pinctrl-0 = <&qspi_pinmux>;
			pinctrl-names = "default";
			status = "okay";
		};

		nss: clock-controller@39B00000 {
			compatible = "qcom,ipq5424-gcc";
			reg = <0 0x39B00000 0 0x80000>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		mdio: mdio@90000 {
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "qcom,ipq4019-mdio";
			reg = <0x00000000 0x00090000 0x00000000 0x00000064>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clk_div = /bits/ 8 <15>;
			status = "okay";
		};

		eth_switch: nss-switch {
			compatible = "qti,ipq-nss-switch";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x3ab00000 0x0 0x000EF800
				0x0 0x3A000000 0x0 0x01000000
				0x0 0x07A00000 0x0 0x00010000>;
			reg-names = "edma_hw", "ppe_base", "uniphy_base";
			assigned-clocks = <&gcc GCC_PCNOC_BFDCD_CLK>,
					  <&gcc GCC_SYSTEM_NOC_BFDCD_CLK>,
					  <&gcc GCC_NSSNOC_MEMNOC_BFDCD_CLK>,
					  <&nss NSS_CC_PPE_CLK>,
					  <&nss NSS_CC_CE_CLK>,
					  <&nss NSS_CC_CFG_CLK>;

			assigned-clock-rates = <100000000>,
					<266666667>,
					<375000000>,
					<375000000>,
					<375000000>,
					<100000000>;
			clocks = <&gcc GCC_IM_SLEEP_CLK>,
				<&nss NSS_CC_NSS_CSR_CLK>,
				<&nss NSS_CC_NSSNOC_NSS_CSR_CLK>,
				<&nss NSS_CC_CE_APB_CLK>,
				<&nss NSS_CC_CE_AXI_CLK>,
				<&nss NSS_CC_NSSNOC_CE_APB_CLK>,
				<&nss NSS_CC_NSSNOC_CE_AXI_CLK>,
				<&gcc GCC_CMN_12GPLL_AHB_CLK>,
				<&gcc GCC_CMN_12GPLL_SYS_CLK>,
				<&gcc GCC_NSSCC_CLK>,
				<&gcc GCC_NSSCFG_CLK>,
				<&gcc GCC_NSSNOC_NSSCC_CLK>,
				<&gcc GCC_NSSNOC_SNOC_CLK>,
				<&gcc GCC_NSSNOC_SNOC_1_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_CLK>,
				<&gcc GCC_NSSNOC_MEMNOC_1_CLK>,
				<&gcc GCC_UNIPHY0_SYS_CLK>,
				<&gcc GCC_UNIPHY1_SYS_CLK>,
				<&gcc GCC_UNIPHY2_SYS_CLK>,
				<&gcc GCC_UNIPHY0_AHB_CLK>,
				<&gcc GCC_UNIPHY1_AHB_CLK>,
				<&gcc GCC_UNIPHY2_AHB_CLK>,
				<&nss NSS_CC_PORT1_MAC_CLK>,
				<&nss NSS_CC_PORT2_MAC_CLK>,
				<&nss NSS_CC_PORT3_MAC_CLK>,
				<&nss NSS_CC_NSSNOC_PPE_CLK>,
				<&nss NSS_CC_NSSNOC_PPE_CFG_CLK>,
				<&nss NSS_CC_PPE_EDMA_CLK>,
				<&nss NSS_CC_PPE_EDMA_CFG_CLK>,
				<&nss NSS_CC_PPE_SWITCH_CLK>,
				<&nss NSS_CC_PPE_SWITCH_IPE_CLK>,
				<&nss NSS_CC_PPE_SWITCH_BTQ_CLK>,
				<&nss NSS_CC_PORT1_RX_CLK>,
				<&nss NSS_CC_PORT1_TX_CLK>,
				<&nss NSS_CC_PORT2_RX_CLK>,
				<&nss NSS_CC_PORT2_TX_CLK>,
				<&nss NSS_CC_PORT3_RX_CLK>,
				<&nss NSS_CC_PORT3_TX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT1_RX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT1_TX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT2_RX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT2_TX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT3_RX_CLK>,
				<&nss NSS_CC_UNIPHY_PORT3_TX_CLK>,
				<&nss UNIPHY0_NSS_RX_CLK>,
				<&nss UNIPHY0_NSS_TX_CLK>,
				<&nss UNIPHY1_NSS_RX_CLK>,
				<&nss UNIPHY1_NSS_TX_CLK>,
				<&nss UNIPHY2_NSS_RX_CLK>,
				<&nss UNIPHY2_NSS_TX_CLK>;
			clock-names = "gcc_im_sleep_clk",
				"nss_cc_nss_csr_clk",
				"nss_cc_nssnoc_nss_csr_clk",
				"nss_cc_ce_ape_clk",
				"nss_cc_ce_axi_clk",
				"nss_cc_nssnoc_ce_apb_clk",
				"nss_cc_nssnoc_ce_axi_clk",
				"gcc_cmn_12gpll_ahb_clk",
				"gcc_cmn_12gpll_sys_clk",
				"gcc_nsscc_clk",
				"gcc_nsscfg_clk",
				"gcc_nssnoc_nsscc_clk",
				"gcc_nssnoc_snoc_clk",
				"gcc_nssnoc_snoc_1_clk",
				"gcc_nssnoc_memnoc_clk",
				"gcc_nssnoc_memnoc_1_clk",
				"gcc_uniphy0_sys_clk",
				"gcc_uniphy1_sys_clk",
				"gcc_uniphy2_sys_clk",
				"gcc_uniphy0_ahb_clk",
				"gcc_uniphy1_ahb_clk",
				"gcc_uniphy2_ahb_clk",
				"nss_cc_port1_mac_clk",
				"nss_cc_port2_mac_clk",
				"nss_cc_port3_mac_clk",
				"nss_cc_nssnoc_ppe_clk",
				"nss_cc_nssnoc_ppe_cfg_clk",
				"nss_cc_ppe_edma_clk",
				"nss_cc_ppe_edma_cfg_clk",
				"nss_cc_ppe_switch_clk",
				"nss_cc_ppe_switch_ipe_clk",
				"nss_cc_ppe_switch_btq_clk",
				"nss_cc_port1_rx_clk",
				"nss_cc_port1_tx_clk",
				"nss_cc_port2_rx_clk",
				"nss_cc_port2_tx_clk",
				"nss_cc_port3_rx_clk",
				"nss_cc_port3_tx_clk",
				"nss_cc_uniphy_port1_rx_clk",
				"nss_cc_uniphy_port1_tx_clk",
				"nss_cc_uniphy_port2_rx_clk",
				"nss_cc_uniphy_port2_tx_clk",
				"nss_cc_uniphy_port3_rx_clk",
				"nss_cc_uniphy_port3_tx_clk",
				"uniphy0_nss_rx_clk",
				"uniphy0_nss_tx_clk",
				"uniphy1_nss_rx_clk",
				"uniphy1_nss_tx_clk",
				"uniphy2_nss_rx_clk",
				"uniphy2_nss_tx_clk";
			resets = <&gcc GCC_UNIPHY0_BCR>,
				<&gcc GCC_UNIPHY1_BCR>,
				<&gcc GCC_UNIPHY2_BCR>,
				<&gcc GCC_UNIPHY0_AHB_RESET>,
				<&gcc GCC_UNIPHY1_AHB_RESET>,
				<&gcc GCC_UNIPHY2_AHB_RESET>,
				<&gcc GCC_UNIPHY0_SOFT_RESET>,
				<&gcc GCC_UNIPHY1_SOFT_RESET>,
				<&gcc GCC_UNIPHY2_SOFT_RESET>,
				<&gcc GCC_UNIPHY0_XPCS_RESET>,
				<&gcc GCC_UNIPHY1_XPCS_RESET>,
				<&gcc GCC_UNIPHY2_XPCS_RESET>,
				<&nss NSS_CC_PPE_BCR>,
				<&nss NSS_CC_PORT1_TX_RESET>,
				<&nss NSS_CC_PORT1_RX_RESET>,
				<&nss NSS_CC_PORT2_TX_RESET>,
				<&nss NSS_CC_PORT2_RX_RESET>,
				<&nss NSS_CC_PORT3_TX_RESET>,
				<&nss NSS_CC_PORT3_RX_RESET>,
				<&nss NSS_CC_PORT1_MAC_RESET>,
				<&nss NSS_CC_PORT2_MAC_RESET>,
				<&nss NSS_CC_PORT3_MAC_RESET>;
			reset-names = "uniphy0_bcr",
				"uniphy1_bcr",
				"uniphy2_bcr",
				"uniphy0_ahb",
				"uniphy1_ahb",
				"uniphy2_ahb",
				"uniphy0_srst",
				"uniphy1_srst",
				"uniphy2_srst",
				"uniphy0_xrst",
				"uniphy1_xrst",
				"uniphy2_xrst",
				"nss_cc_ppe_bcr",
				"nss_cc_port1_tx",
				"nss_cc_port1_rx",
				"nss_cc_port2_tx",
				"nss_cc_port2_rx",
				"nss_cc_port3_tx",
				"nss_cc_port3_rx",
				"nss_cc_port1_mac",
				"nss_cc_port2_mac",
				"nss_cc_port3_mac";
			tdm_offset = <0xc000>;
			tdm_mode = <0>;
			no_tdm_reg = <126>;
			bridge_mode;
			status = "okay";
		};

		watchdog: non-sec@f410000 {
			compatible = "qcom,apss-wdt-ipq5424", "qcom,kpss-wdt";
			#address-cells = <2>;
			#size-cells = <2>;
			reg =  <0x0 0xf410000 0x0 0x1000>;
			clocks = <&sleep_clk>;
			timeout-sec = <30>;
			status = "okay";
		};
	};
};

&tlmm {
	uart1_pins: uart1-state {
		bootph-all;
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	spi0_pinmux: spi0 {
		spi0_sclk {
			pins = "gpio6";
			function = "spi0_clk";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_cs0 {
			pins = "gpio7";
			function = "spi0_cs";
			drive-strength = <8>;
			bias-pull-up;
		};

		spi0_miso {
			pins = "gpio8";
			function = "spi0_miso";
			drive-strength = <8>;
			bias-pull-down;
		};

		spi0_mosi {
			pins = "gpio9";
			function = "spi0_mosi";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	qspi_pinmux: nand {
		qspi_data {
			pins = "gpio0", "gpio1", "gpio2","gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		qspi_cs_n {
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-pull-up;
                };

		qspi_clk {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
        };
};

&sdhc {
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	sdhci-caps-mask = <0x0 0x04000000>;
	sdhci-caps = <0x0 0x04000000>;
	resets = <&gcc GCC_SDCC_BCR>;
	reset-names = "bcr_rst";
	status = "okay";
};

&qupv3 {
	uart1_fw: uart_firmware@0 {
		compatible = "qcom,ipq5424-geni-uart-fw-v1",
			     "qcom,geni-uart-fw-v1";
		reg = <0 0x01a84000 0 0x4000>;
		status = "okay";
	};

	i2c0: i2c@1a88000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C0_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C0_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c0_fw>;
		qcom,geni-se-clk-32mhz;
	};

	i2c0_fw: i2c0_firmware@0 {
		compatible = "qcom,ipq5424-geni-i2c-fw-v1",
			     "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a88000 0x0 0x4000>;
		status = "okay";
	};

	i2c1: i2c@1a8c000 {
		compatible = "qcom,geni-i2c";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		reg-names = "se_phys";
		assigned-clocks = <&gcc GCC_QUPV3_I2C1_CLK>;
		assigned-clock-rates = <64000000>;
		clocks = <&gcc GCC_QUPV3_I2C1_CLK>;
		clock-names = "se";
		clock-frequency = <400000>;
		qup-se-fw-load = <&i2c1_fw>;
		qcom,geni-se-clk-32mhz;
	};

	i2c1_fw: i2c1_firmware@0 {
		compatible = "qcom,ipq5424-geni-i2c-fw-v1",
			     "qcom,geni-i2c-fw-v1";
		reg = <0x0 0x1a8c000 0x0 0x4000>;
		status = "okay";
	};

	spi0: spi@1a90000 {
		compatible = "qcom-ipq5424-geni-spi";
		reg = <0 0x1a90000 0 0x4000>;
		reg-names = "se_phys";
		clocks = <&gcc GCC_QUPV3_SPI0_CLK>;
		clock-names = "se-spi-clk";
		clock-frequency = <50000000>;
		nor-blk-enable;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		qup-se-fw-load = <&spi_fw>;

		pinctrl-0 = <&spi0_pinmux>;
		pinctrl-names = "default";

		nor-flash@0 {
			compatible = "jedec,spi-nor";
			reg = <0 0 0 0>;
			spi-max-frequency = <50000000>;
		};
	};

	spi_fw: spi_firmware@0 {
		compatible = "qcom,ipq5424-geni-spi-fw-v1",
			     "qcom,geni-spi-fw-v1";
		reg = <0 0x1a90000 0 0x4000>;
		reg-names = "se_phys";
	};

	se5: se5@1a94000 {
		reg = <0 0x1a94000 0 0x4000>;
		reg-names = "se_phys";
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&uart1 {
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	qup-se-fw-load = <&uart1_fw>;
	status = "okay";
};

&xo_board {
	clock-frequency = <24000000>;
};
