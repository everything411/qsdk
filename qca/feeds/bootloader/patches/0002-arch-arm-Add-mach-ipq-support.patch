 config PINCTRL_QCOM
 	depends on PINCTRL_GENERIC
@@ -27,6 +27,27 @@ config PINCTRL_QCOM_IPQ4019
 	  Say Y here to enable support for pinctrl on the IPQ4019 SoC,
 	  as well as the associated GPIO driver.
 
+config PINCTRL_QCOM_IPQ5332
+	bool "Qualcomm IPQ5332 GCC"
+	select PINCTRL_QCOM
+	help
+	  Say Y here to enable support for pinctrl on the IPQ5332 SoC,
+	  as well as the associated GPIO driver.
+
+config PINCTRL_QCOM_IPQ5424
+	bool "Qualcomm IPQ5424 GCC"
+	select PINCTRL_QCOM
+	help
+	  Say Y here to enable support for pinctrl on the IPQ5424 SoC,
+	  as well as the associated GPIO driver.
