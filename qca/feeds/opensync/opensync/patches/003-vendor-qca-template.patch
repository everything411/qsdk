--- /dev/null
+++ b/src/vendor/qca-template/rootfs/common/etc/hotplug.d/net/99-regdomain
@@ -0,0 +1,31 @@
+#!/bin/sh
+#
+#
+# Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
+# SPDX-License-Identifier: ISC
+# Set wifi regulatory domain when VAP is created on given radio
+#
+
+[ "$ACTION" = add ] || exit 0
+grep -q "$INTERFACE" /proc/net/wireless || exit 0
+
+configure_country()
+{
+    local radio=$1
+    local next_country=$2
+    local prev_country=$(cfg80211tool $radio getCountry | sed 's/.*://g')
+
+    if [ "$prev_country" != "$next_country" ]; then
+        logger "$radio: setCountry $next_country, prev=$prev_country"
+        cfg80211tool $radio setCountry $next_country > /dev/console 2>&1
+    fi
+}
+
+country=US # Using US as a default setting
+radio=$(cat /sys/class/net/$INTERFACE/parent)
+
+case "$radio" in
+    wifi*)
+        configure_country $radio $country
+        ;;
+esac
