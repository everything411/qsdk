Index: opensync-6.4/src/platform/qca/src/lib/target/wiphy_info_11ax.c
===================================================================
--- opensync-6.4.orig/src/platform/qca/src/lib/target/wiphy_info_11ax.c
+++ opensync-6.4/src/platform/qca/src/lib/target/wiphy_info_11ax.c
@@ -84,6 +84,7 @@ static const struct {
     { 0, 0, "qcom,cnss-qcn6122", "qcn6122", "Spruce" },
     { 0, 0, "qcom,cnss-qca5332", "qca5332", "Miami" },
     { 0, 0, "qcom,cnss-qcn6432", "qcn6432", "Pebble" },
+    { 0, 0, "qcom,cnss-qca5424", "qca5424", "ipq5424" },
 };
 
 /* runtime data */
@@ -431,7 +432,8 @@ wiphy_info_init_ifname(const char *ifnam
         info->mode = "11ax";
     } else if (!strcmp(info->chip, "qcn9224") ||
                !strcmp(info->chip, "qca5332") ||
