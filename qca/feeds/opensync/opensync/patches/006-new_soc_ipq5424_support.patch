Index: opensync-6.4/src/vendor/qca-template/kconfig/targets/IPQ5424_RDP466
===================================================================
--- /dev/null
+++ opensync-6.4/src/vendor/qca-template/kconfig/targets/IPQ5424_RDP466
@@ -0,0 +1,34 @@
+#
+# Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
+# SPDX-License-Identifier: ISC
+@include "base_ipq54xx"
+CONFIG_CM2_STABILITY_THRESH_CPU="1.5"
+CONFIG_MANAGER_WANO_IFACE_LIST="eth0 eth1"
+# CONFIG_MANAGER_WM is not set
+# CONFIG_MANAGER_BM is not set
+CONFIG_OSN_BACKEND_FW_IPTABLES_THIN=y
+CONFIG_OVSDB_BOOTSTRAP=y
+CONFIG_OVSDB_BOOTSTRAP_WIFI_PHY_LIST="wifi0:15:HT40:11be:2.4G:qcn9224::200 wifi1:15:HT320:11be:6G:qcn9224 wifi2:15:HT80:11be:5G:qcn9224:dfs_usenol=\"1\",dfs_ignorecac=\"0\",dfs_enable=\"1\""
+CONFIG_OVSDB_BOOTSTRAP_WIFI_STA_LIST="wifi0:bhaul-sta-24 wifi1:bhaul-sta-60 wifi2:bhaul-sta-50"
+CONFIG_TARGET_ENABLE_EBTABLES=y
+CONFIG_TARGET_ENABLE_TC_FILTERS=y
+CONFIG_TARGET_ETH1_LIST=y
+CONFIG_TARGET_ETH1_NAME="eth1"
+CONFIG_TARGET_MODEL="IPQ5424-RDP466"
+CONFIG_TARGET_NAME="IPQ5424_RDP466"
+CONFIG_TARGET_USE_NATIVE_BRIDGE=y
+CONFIG_FCM_LAN_STATS_COLLECT_METHOD=y
+CONFIG_VENDOR_IS_QCA_TEMPLATE=y
+CONFIG_TARGET_IMC=y
+CONFIG_MANAGER_FCM=y
+CONFIG_MANAGER_QOSM=y
+CONFIG_MANAGER_VPNM=y
+CONFIG_PM_ENABLE_TM=y
+# CONFIG_PM_ENABLE_FAN_DUTY_CYCLE is not set
+CONFIG_PM_ENABLE_OBJM=y
+CONFIG_PM_GW_OFFLINE_CFG=y
+CONFIG_MANAGER_FM=y
+CONFIG_OSBUS_LIB=y
+CONFIG_OSBUS_UBUS=y
+CONFIG_USE_OSBUS=y
+#CONFIG_WPD_WATCHDOG_DEVICE="/dev/watchdog1"
Index: opensync-6.4/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/start.d/90_accel.sh
===================================================================
--- opensync-6.4.orig/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/start.d/90_accel.sh
+++ opensync-6.4/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/start.d/90_accel.sh
@@ -44,6 +44,12 @@ udp_deny_ports() {
     echo "add $UDP_SLOW_PATH_PORTS" > /proc/sys/net/ecm/udp_denied_ports
 }
 
+configure_ipq5424() {
+    udp_deny_ports
+    disable_fdb_forward
+    configure_packet_deferral
+}
+
 configure_miami() {
     udp_deny_ports
     disable_fdb_forward
@@ -77,6 +83,7 @@ case "$board" in
     IPQ40xx) configure_dakota ;;
     IPQ807x) configure_hawkeye ;;
     IPQ8074) configure_hawkeye ;;
+    IPQ5424*RDP466) configure_ipq54xx ;;
     IPQ6018) configure_unsupported ;;
     IPQ5018) configure_unsupported ;;
     IPQ5332) configure_unsupported ;;
