Index: opensync-6.4/src/vendor/qca-template/build/qsdk.mk
===================================================================
--- opensync-6.4.orig/src/vendor/qca-template/build/qsdk.mk
+++ opensync-6.4/src/vendor/qca-template/build/qsdk.mk
@@ -30,7 +30,7 @@ SDK_DIR        = $(TOPDIR)
 SDK_LIB_DIR   += -L$(STAGING_DIR)/lib
 
 SDK_CFLAGS    += -Os -pipe -fno-caller-saves -fhonour-copts
-SDK_CFLAGS    += -Wno-error=unused-but-set-variable
+SDK_CFLAGS    += -g3 -Wno-error=unused-but-set-variable -Wno-error=deprecated-declarations -Wno-error=return-type -Wno-error=int-conversion -Wno-error=implicit-function-declaration
 ifneq ($(ARCH_64BIT),y)
 SDK_CFLAGS    += -msoft-float
 endif
Index: opensync-6.4/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/prov
===================================================================
--- opensync-6.4.orig/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/prov
+++ opensync-6.4/src/platform/qca/rootfs/common/INSTALL_PREFIX/scripts/prov
@@ -228,6 +228,20 @@ prov_wifi() {
     phy="phy#$wiphy"
     suffix=$(radio_suffix $phy)
     suffix_short=$(short_radio_suffix_try $phy)
+    
+    if [ -n $suffix ] || [  -n $suffix_short ]; then
+    	radio=$(cat /sys/class/net/"$wifi"/supported_bands)
+    	if [ $radio  == "2GHz/" ];then
+    		suffix=24
+    		suffix_short=24
+    	elif [ $radio  == "6GHz/" ];then
+    		suffix=60
+    		suffix_short=60
+    	elif [ $radio  == "5GHz/" ];then
+    		suffix=50
+    		suffix_short=50
+    	fi
+    fi
 
     log_info "prov: $wifi: $vap: provisioning, mode=$mode"
 
