@@ -892,6 +889,31 @@ util_iwconfig_get_chan(const char *phy,
     num = 0;
     mhz_last = 0;
 
+#ifdef OPENSYNC_NL_SUPPORT
+    const char *buff;
+    for (vif = strtok_r(vifs, " ", &vifr); vif; vif = strtok_r(NULL, " ", &vifr)) {
+	buff = strexa("iw", vif, "info");
