         return;
     while ((vif = strsep(&vifs, " ")) != NULL)
         if (strlen(vif) > 0)
+#ifdef OPENSYNC_NL_SUPPORT
+            WARN_ON(!strexa("iw", vif, "set", "txpower", "fixed", txpwr));
+#else
             WARN_ON(!strexa("iwconfig", vif, "txpower", txpwr));
+#endif
 }
 
