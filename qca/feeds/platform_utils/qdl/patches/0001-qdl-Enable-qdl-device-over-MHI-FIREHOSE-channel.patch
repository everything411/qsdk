@@ -107,15 +108,17 @@ int main(int argc, char **argv)
 	char *serial = NULL;
 	const char *vip_generate_dir = NULL;
 	const char *vip_table_path = NULL;
+	const char *mhi_device_path = NULL;
 	int type;
 	int ret;
 	int opt;
 	bool qdl_finalize_provisioning = false;
 	bool allow_fusing = false;
 	bool allow_missing = false;
+	bool use_mhi = false;
 	long out_chunk_size = 0;
 	struct qdl_device *qdl = NULL;
-	enum QDL_DEVICE_TYPE qdl_dev_type = QDL_DEVICE_USB;
+	enum QDL_DEVICE_TYPE qdl_dev_type = QDL_DEVICE_UNKNOWN;
 
 	static struct option options[] = {
 		{"debug", no_argument, 0, 'd'},
@@ -130,11 +133,12 @@ int main(int argc, char **argv)
 		{"allow-fusing", no_argument, 0, 'c'},
 		{"dry-run", no_argument, 0, 'n'},
 		{"create-digests", required_argument, 0, 't'},
+		{"use-mhi", optional_argument, 0, 'm'},
 		{"help", no_argument, 0, 'h'},
 		{0, 0, 0, 0}
 	};
 
-	while ((opt = getopt_long(argc, argv, "dvi:lu:S:D:s:fcnt:h", options, NULL)) != -1) {
+	while ((opt = getopt_long(argc, argv, "dvi:lu:S:D:s:fcnt:m::h", options, NULL)) != -1) {
 		switch (opt) {
 		case 'd':
 			qdl_debug = true;
@@ -174,6 +178,11 @@ int main(int argc, char **argv)
 		case 'D':
 			vip_table_path = optarg;
 			break;
+		case 'm':
+			use_mhi = true;
+			if (optarg)
+				mhi_device_path = optarg;
+			break;
 		case 'h':
 			print_usage(stdout);
 			return 0;
@@ -189,12 +198,24 @@ int main(int argc, char **argv)
 		return 1;
 	}
 
+	if (qdl_dev_type == QDL_DEVICE_UNKNOWN) {
+		if (use_mhi)
+			qdl_dev_type = QDL_DEVICE_MHI;
+		else
+			qdl_dev_type = QDL_DEVICE_USB;
+	} else if (use_mhi && qdl_dev_type == QDL_DEVICE_SIM) {
+		errx(1, "Error: -m option is invalid when -n or -t is specified");
+	}
+
 	qdl = qdl_init(qdl_dev_type);
 	if (!qdl) {
 		ret = -1;
 		goto out_cleanup;
 	}
 
+	if (mhi_device_path)
+		mhi_device_update(qdl, mhi_device_path);
+
 	if (vip_table_path) {
 		if (vip_generate_dir)
 			errx(1, "VIP mode and VIP table generation can't be enabled together\n");
@@ -260,9 +281,11 @@ int main(int argc, char **argv)
 		goto out_cleanup;
 
 	qdl->mappings[0] = prog_mbn;
-	ret = sahara_run(qdl, qdl->mappings, true, NULL, NULL);
-	if (ret < 0)
-		goto out_cleanup;
+	if (qdl_dev_type != QDL_DEVICE_MHI) { //Sahara transfer is handled by MHI driver sysfs
+		ret = sahara_run(qdl, qdl->mappings, true, NULL, NULL);
+		if (ret < 0)
+			goto out_cleanup;
+	}
 
 	ret = firehose_run(qdl, incdir, storage, allow_missing);
 	if (ret < 0)
