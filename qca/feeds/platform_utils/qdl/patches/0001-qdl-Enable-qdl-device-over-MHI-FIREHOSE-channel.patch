+QDL_SRCS := firehose.c io.c qdl.c sahara.c util.c patch.c program.c read.c sha2.c sim.c ufs.c usb.c mhi.c ux.c oscompat.c vip.c sparse.c
 QDL_OBJS := $(QDL_SRCS:.c=.o)
 
-RAMDUMP_SRCS := ramdump.c sahara.c io.c sim.c usb.c util.c ux.c oscompat.c
+RAMDUMP_SRCS := ramdump.c sahara.c io.c sim.c usb.c mhi.c util.c ux.c oscompat.c
 RAMDUMP_OBJS := $(RAMDUMP_SRCS:.c=.o)
 
 KS_OUT := ks
diff --git a/io.c b/io.c
index 5b1d36e..a792e2a 100644
--- a/io.c
+++ b/io.c
@@ -11,6 +11,9 @@ struct qdl_device *qdl_init(enum QDL_DEVICE_TYPE type)
 	if (type == QDL_DEVICE_USB)
 		return usb_init();
 
+	if (type == QDL_DEVICE_MHI)
+		return mhi_init();
+
 	if (type == QDL_DEVICE_SIM)
 		return sim_init();
 
diff --git a/mhi.c b/mhi.c
new file mode 100644
index 0000000..b3bfc4c
--- /dev/null
+++ b/mhi.c
@@ -0,0 +1,86 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "oscompat.h"
+#include "qdl.h"
+
+#define MHI_DEVICE_PATH "/dev/wwan0firehose0"
+
+struct qdl_device_mhi {
+	struct qdl_device base;
+};
+
+static int mhi_open(struct qdl_device *qdl, const char *serial)
+{
+	if (access(qdl->device_path, F_OK) != 0) {
+		err(1, "cannot find %s", qdl->device_path);
+		return -ENODEV;
+	}
+
+	qdl->fd = open(qdl->device_path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+
+	return 0;
+}
+
+static void mhi_close(struct qdl_device *qdl)
+{
+	int ret;
+
+	ret = close(qdl->fd);
+
+	if(ret)
+		perror("mhi firehose device failed to close");
+}
+
+static int mhi_read(struct qdl_device *qdl, void *buf, size_t len, unsigned int timeout)
+{
+	int ret;
+	struct pollfd pollfds[] = {{qdl->fd, POLLIN, 0}};
+
+	ret = poll(pollfds, 1, timeout);
+	if (ret <= 0)
+		return ret;
+
+	return read(qdl->fd, buf, len);
+}
+
+static int mhi_write(struct qdl_device *qdl, const void *buf, size_t nbytes)
+{
+	int ret;
+	struct pollfd pollfds[] = {{qdl->fd, POLLOUT, 0}};
+
+	ret = poll(pollfds, 1, 5000);
+	if (ret <= 0)
+		return ret;
+
+	return write(qdl->fd, buf, nbytes);
+}
+
+void mhi_device_update(struct qdl_device *qdl, const char *path)
+{
+	qdl->device_path = path;
+}
+
+struct qdl_device *mhi_init(void)
+{
+	struct qdl_device *qdl = malloc(sizeof(struct qdl_device_mhi));
+
+	if (!qdl)
+		return NULL;
+
+	memset(qdl, 0, sizeof(struct qdl_device_mhi));
+
+	qdl->dev_type = QDL_DEVICE_MHI;
+	qdl->open = mhi_open;
+	qdl->read = mhi_read;
+	qdl->write = mhi_write;
+	qdl->close = mhi_close;
+	qdl->device_path = MHI_DEVICE_PATH;
+
+	return qdl;
+}
