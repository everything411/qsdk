+/* To obtain the dut's mld link_id based on the band information */
+int get_link_id_by_band(struct sigma_dut *dut, enum if_band band)
+{
+	int link_id;
+
+	for (link_id = 0; link_id < NUM_OF_LINKS; link_id++) {
+		if (check_band(dut, band, link_id))
+			break;
+	}
+
+	return link_id;
