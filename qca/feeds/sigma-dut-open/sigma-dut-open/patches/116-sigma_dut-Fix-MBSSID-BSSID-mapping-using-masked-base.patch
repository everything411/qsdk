From f3bed4196b3c9e5351529abf147cff8f3fd00282 Mon Sep 17 00:00:00 2001
From: Naveen Sivasamy <naves@qti.qualcomm.com>
Date: Wed, 11 Feb 2026 17:45:39 +0530
Subject: [PATCH] sigma-dut: Update MBSSID grouping MAC address generation
 logic

The requirement for MBSSID grouping testcases mandates a specific MAC
address format: AA:BB:CC:DD:EE:XY.
- AA:BB:CC:DD:EE is constant for all APs in a radio.
- X is constant for all VAPs (upper nibble of last byte).
- Y (lower nibble) contains the variations.
  - Higher bits of Y are for Group Index.
  - Lower bits of Y are for BSS Index.

Previously, the logic did not strictly enforce this partitioning of
the nibble Y and was modifying the 5th byte (EE) by decrementing it
based on the group index.

Update the MAC address generation to explicitly mask and set the Group
Index and BSS Index bits within the lower nibble of the last byte,
ensuring compliance with the requirement. The Group Index is
incremented by the BSS block size (max_bss_count) for each group,
ensuring it occupies the higher bits of the nibble relative to the BSS
bits. Also remove the decrement of the 5th byte (bssid[4]) as the
requirement states it should remain constant.

Fixes: I8e4d55c68(UPSTREAM:PROTOCOL: sigma_dut: Add support for MBSSID
                  grouping)

Signed-off-by: Naveen Sivasamy <naves@qti.qualcomm.com>
---
 ap.c | 36 ++++++++++++++++++++----------------
 1 file changed, 20 insertions(+), 16 deletions(-)

diff --git a/ap.c b/ap.c
index 1f70257..a1c6a7b 100644
--- a/ap.c
+++ b/ap.c
@@ -11794,17 +11794,33 @@ skip_vht_parameters_set:
 		    dut->ap_mbssid == VALUE_ENABLED && !link_id &&
 		    dut->multi_mbssid) {
 			uint8_t num_bss, bssid_mask, max_bss_count;
-			uint8_t init_val, base_val;
 			uint8_t max_bssid_ind = 0;
 			unsigned char bssid[6];
 			char ifname2[50];
 			int i, count = 0;
+			uint8_t m_addr_bits, n_addr_bits, grp_idx, bss_idx;
 
 			if (get_hwaddr(ifname, bssid)) {
 				fclose(f);
 				return -2;
 			}
 
+			m_addr_bits = bssid[5] & 0xF0;
+			n_addr_bits = bssid[5] & 0x0F;
+
+			num_bss = dut->mbss_set[0].num_non_tx_bss;
+
+			do {
+				max_bssid_ind++;
+				num_bss = num_bss >> 1;
+			} while (num_bss);
+
+			max_bss_count = 1 << max_bssid_ind;
+			bssid_mask = max_bss_count - 1;
+
+			grp_idx = n_addr_bits & ~bssid_mask;
+			bss_idx = n_addr_bits & bssid_mask;
+
 			for (int j = 0; j < dut->no_of_mbssid_groups; j++) {
 				if (!dut->mbss_set[j].num_non_tx_bss)
 					return -2;
@@ -11819,24 +11835,11 @@ skip_vht_parameters_set:
 				if (dut->mbss_set[j].num_non_tx_bss > 255)
 					return -2;
 
-				num_bss = dut->mbss_set[j].num_non_tx_bss;
-
-				do {
-					max_bssid_ind++;
-					num_bss = num_bss >> 1;
-				} while (num_bss);
-
-				max_bss_count = 1 << max_bssid_ind;
-				bssid_mask = max_bss_count - 1;
-
-				base_val = bssid[5] & ~bssid_mask;
-				init_val = bssid[5] & bssid_mask;
-
 				for (i = 0; i < dut->mbss_set[j].num_non_tx_bss + 1; i++) {
 					fprintf(f, "\n");
 
 					/* start from 1 for non tx bssid */
-					bssid[5] = base_val + ((init_val + count + 1) % max_bss_count);
+					bssid[5] = m_addr_bits + grp_idx + ((bss_idx + count + 1) % max_bss_count);
 
 					if ((i == 0) && (j == 0)) {
 						fprintf(f, "interface=%s\n", ifname);
@@ -11862,7 +11865,7 @@ skip_vht_parameters_set:
 
 					fprintf(f, "bssid=%02x:%02x:%02x:%02x:%02x:%02x\n",
 						bssid[0], bssid[1], bssid[2], bssid[3],
-						bssid[4] - j, bssid[5]);
+						bssid[4], bssid[5]);
 
 					memcpy(dut->mbss_set[j].conf[i].non_tx_bssid, bssid, 6);
 
@@ -11902,6 +11905,7 @@ skip_vht_parameters_set:
 
 					count = count + 1;
 				}
+				grp_idx = (grp_idx + max_bss_count) & 0x0F;
 			}
 		} else if ((dut->program == PROGRAM_HE || dut->program == PROGRAM_EHT) &&
 		    dut->ap_mbssid == VALUE_ENABLED && !link_id) {
-- 
