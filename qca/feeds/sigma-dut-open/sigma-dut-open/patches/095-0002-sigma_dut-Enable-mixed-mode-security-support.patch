From ef64d01ab9ac12fb64337534565ce29fb4396559 Mon Sep 17 00:00:00 2001
From: Naveen S <quic_naves@quicinc.com>
Date: Wed, 4 Sep 2024 15:18:35 +0530
Subject: [PATCH] sigma_dut: Enable mixed mode security support

For mixed mode, the security related values needs to be updated
differently for each link and for other cases the security values
needs to be updated commonly for all the links in a mld.

Add support to update security specific parameters in case of
mixed mode.

Signed-off-by: Dhanavandhana Kannan <quic_dhanavan@quicinc.com>
Signed-off-by: Naveen S <quic_naves@quicinc.com>
---
 ap.c | 188 ++++++++++++++++++++++++++++++++++++++++++++++++-----------
 1 file changed, 155 insertions(+), 33 deletions(-)

--- a/ap.c
+++ b/ap.c
@@ -3210,6 +3210,145 @@ static const char * get_sae_pk_key(const
 	return NULL;
 }
 
+static int ap_set_security_mixed_mode(struct sigma_dut *dut,
+				      struct sigma_conn *conn,
+				      struct sigma_cmd *cmd)
+{
+	const char *val;
+	unsigned int link_id = dut->security_links - 1;
+
+	val = get_param(cmd, "PSK");
+	if (!val)
+		val = get_param(cmd, "passphrase");
+	if (val) {
+		if (dut->ap_key_mgmt != AP_WPA2_SAE &&
+		    (dut->mld[link_id].ap_akm_link &
+		     (AKM_WPA_PSK | AKM_SAE)) !=
+		    AKM_SAE && strlen(val) > 64) {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"Too long PSK/passphtase");
+			return -1;
+		}
+		if (strlen(val) > sizeof(dut->ap_passphrase) - 1)
+			return -1;
+		snprintf(dut->ap_passphrase, sizeof(dut->ap_passphrase),
+			 "%s", val);
+	}
+
+	val = get_param(cmd, "AKMSuiteType");
+	if (val) {
+		const char *in_pos = val;
+		int akm_values = 0;
+
+		while (*in_pos) {
+			int akm = atoi(in_pos);
+
+			if (akm < 0 || akm >= 32) {
+				send_resp(dut, conn, SIGMA_ERROR,
+					  "errorCode,Unsupported AKMSuiteType value");
+				return STATUS_SENT;
+			}
+
+			akm_values |= 1 << akm;
+
+			in_pos = strchr(in_pos, ';');
+			if (!in_pos)
+				break;
+			while (*in_pos == ';')
+				in_pos++;
+		}
+		dut->ap_akm = 1;
+		if (akm_values & (1 << 14))
+			dut->ap_add_sha384 = 1;
+		if (akm_values & (1 << 15))
+			dut->ap_add_sha384 = 1;
+
+		dut->mld[link_id].ap_akm_link = akm_values;
+	}
+
+	val = get_param(cmd, "PairwiseCipher");
+	if (val) {
+		if (strcasecmp(val, "AES-GCMP-256") == 0)
+			dut->mld[link_id].ap_cipher_link = AP_GCMP_256;
+		else if (strcasecmp(val, "AES-CCMP-256") == 0)
+			dut->mld[link_id].ap_cipher_link = AP_CCMP_256;
+		else if (strcasecmp(val, "AES-GCMP-128") == 0)
+			dut->mld[link_id].ap_cipher_link = AP_GCMP_128;
+		else if (strcasecmp(val, "AES-CCMP-128") == 0)
+			dut->mld[link_id].ap_cipher_link = AP_CCMP;
+		else if (strcasecmp(val, "AES-CCMP-128 AES-GCMP-256") == 0 ||
+			   strcasecmp(val, "AES-GCMP-256 AES-CCMP-128") == 0)
+			dut->mld[link_id].ap_cipher_link = AP_CCMP_128_GCMP_256;
+		else {
+			send_resp(dut, conn, SIGMA_INVALID,
+				  "errorCode,Unsupported PairwiseCipher");
+			return 0;
+		}
+	}
+
+	val = get_param(cmd, "GroupCipher");
+	if (val) {
+		if (strcasecmp(val, "AES-GCMP-256") == 0)
+			dut->mld[link_id].ap_group_cipher_link = AP_GCMP_256;
+		else if (strcasecmp(val, "AES-CCMP-256") == 0)
+			dut->mld[link_id].ap_group_cipher_link = AP_CCMP_256;
+		else if (strcasecmp(val, "AES-GCMP-128") == 0)
+			dut->mld[link_id].ap_group_cipher_link = AP_GCMP_128;
+		else if (strcasecmp(val, "AES-CCMP-128") == 0)
+			dut->mld[link_id].ap_group_cipher_link = AP_CCMP;
+		else {
+			send_resp(dut, conn, SIGMA_INVALID,
+				  "errorCode,Unsupported GroupCipher");
+			return 0;
+		}
+	}
+
+	val = get_param(cmd, "GroupMgntCipher");
+	if (val) {
+		if (strcasecmp(val, "BIP-GMAC-256") == 0)
+			dut->mld[link_id].ap_group_mgmt_cipher_link = AP_BIP_GMAC_256;
+		else if (strcasecmp(val, "BIP-CMAC-256") == 0)
+			dut->mld[link_id].ap_group_mgmt_cipher_link = AP_BIP_CMAC_256;
+		else if (strcasecmp(val, "BIP-GMAC-128") == 0)
+			dut->mld[link_id].ap_group_mgmt_cipher_link = AP_BIP_GMAC_128;
+		else if (strcasecmp(val, "BIP-CMAC-128") == 0)
+			dut->mld[link_id].ap_group_mgmt_cipher_link = AP_BIP_CMAC_128;
+		else {
+			send_resp(dut, conn, SIGMA_INVALID,
+				  "errorCode,Unsupported GroupMgntCipher");
+			return 0;
+		}
+	}
+
+	val = get_param(cmd, "PMF");
+	if (val) {
+		if (strcasecmp(val, "Disabled") == 0)
+			dut->mld[link_id].ap_pmf_link = AP_PMF_DISABLED;
+		else if (strcasecmp(val, "Optional") == 0)
+			dut->mld[link_id].ap_pmf_link = AP_PMF_OPTIONAL;
+		else if (strcasecmp(val, "Required") == 0)
+			dut->mld[link_id].ap_pmf_link = AP_PMF_REQUIRED;
+		else {
+			send_resp(dut, conn, SIGMA_INVALID,
+				  "errorCode,Unsupported PMF");
+			return 0;
+		}
+	}
+
+	val = get_param(cmd, "BeaconProtection");
+	if (val)
+		dut->mld[link_id].ap_beacon_prot_link = atoi(val);
+
+	val = get_param(cmd, "ECGroupID");
+	if (val) {
+		free(dut->mld[link_id].ap_sae_groups_link);
+		dut->mld[link_id].ap_sae_groups_link = strdup(val);
+	}
+
+	dut->security_links++;
+	return 1;
+}
