+bool contains_ccmp_gcmp_128_256_ciphers(const char *val) {
+	char *tokens[4]; // to store the four ciphers
+	char *temp_val = strdup(val); // duplicate the string to avoid modifying the original
+	char *saveptr;
+	char *token = strtok_r(temp_val, " ", &saveptr);
+	int found[4] = {0}; // to track which ciphers have been found
+
+	int i = 0;
+	while (token != NULL && i < 4) {
+		tokens[i++] = token;
+		token = strtok_r(NULL, " ", &saveptr);
+	}
+
+	// Check if the required ciphers are in the parsed tokens
+	for (int j = 0; j < 4; j++) {
+		if (strcmp(tokens[j], "AES-CCMP-128") == 0)
+			found[0] = 1;
+		else if (strcmp(tokens[j], "AES-CCMP-256") == 0)
+			found[1] = 1;
+		else if (strcmp(tokens[j], "AES-GCMP-128") == 0)
+			found[2] = 1;
+		else if (strcmp(tokens[j], "AES-GCMP-256") == 0)
+			found[3] = 1;
+	}
+	free(temp_val);
+
+	// Return true only if all ciphers were found
+	return (found[0] && found[1] && found[2] && found[3]);
+}
