From 13fe551af3cc8e135345e4cdb4fc7979d67c72f6 Mon Sep 17 00:00:00 2001
From: Naveen Sivasamy <naves@qti.qualcomm.com>
Date: Tue, 1 Jul 2025 13:12:35 +0530
Subject: [PATCH] UPSTREAM:PROTOCOL:sigma_dut: Adding support for WiFi 7 EPCS
 feature

Adding support for WiFi 7 APUT Emergency Preparedness Communications
Services(EPCS) feature. CAPI parameters added to support the feature
are EPCS and EPCS_Setup.

Signed-off-by: Naveen Sivasamy <naves@qti.qualcomm.com>
---
 ap.c        | 84 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 sigma_dut.h |  1 +
 2 files changed, 85 insertions(+)

--- a/ap.c
+++ b/ap.c
@@ -3073,6 +3073,19 @@ static enum sigma_cmd_result cmd_ap_set_
 		}
 	}
 
+	val = get_param(cmd, "EPCS");
+	if (val) {
+		if (strcasecmp(val, "enable") == 0) {
+			dut->ap_epcs = VALUE_ENABLED;
+		} else if (strcasecmp(val, "disable") == 0) {
+			dut->ap_epcs = VALUE_DISABLED;
+		} else {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Unsupported EPCS Value");
+			return STATUS_SENT_ERROR;
+		}
+	}
+
 	return SUCCESS_SEND_STATUS;
 }
 
