+	val = get_param(cmd, "EPCS_Setup");
+	if (val) {
+		 if (strcasecmp(val, "Authorize") == 0) {
+			val = get_param(cmd, "client_mac");
+			if (val) {
+				if (parse_mac_address(dut, val, mac_addr) < 0) {
+				    sigma_dut_print(dut, DUT_MSG_ERROR,
+						"MAC Address not in proper format");
+				    return STATUS_SENT_ERROR;
+				}
+
+				run_system_wrapper(dut, "hostapd_cli -i %s %s epcs authorize_mac %02x:%02x:%02x:%02x:%02x:%02x",
+						   ifname, link_set ? link_param : "", mac_addr[0], mac_addr[1], mac_addr[2],
+						   mac_addr[3], mac_addr[4], mac_addr[5]);
+			}
+		} else if (strcasecmp(val, "Request") == 0) {
+			val = get_param(cmd, "client_mac");
+			if (val) {
+				if (parse_mac_address(dut, val, mac_addr) < 0) {
+				    sigma_dut_print(dut, DUT_MSG_ERROR,
+						"MAC Address not in proper format");
+				    return STATUS_SENT_ERROR;
+				}
+
+				run_system_wrapper(dut, "hostapd_cli -i %s %s epcs authorize_mac %02x:%02x:%02x:%02x:%02x:%02x",
+						   ifname, link_set ? link_param : "", mac_addr[0], mac_addr[1], mac_addr[2],
+						   mac_addr[3], mac_addr[4], mac_addr[5]);
+				run_system_wrapper(dut, "hostapd_cli -i %s %s epcs session_initiate  %02x:%02x:%02x:%02x:%02x:%02x",
+						   ifname, link_set ? link_param : "", mac_addr[0], mac_addr[1], mac_addr[2],
+						   mac_addr[3], mac_addr[4], mac_addr[5]);
+			}
+		} else if (strcasecmp(val, "Teardown") == 0) {
+			val = get_param(cmd, "client_mac");
+			if (val) {
+				if (parse_mac_address(dut, val, mac_addr) < 0) {
+				    sigma_dut_print(dut, DUT_MSG_ERROR,
+						"MAC Address not in proper format");
+				    return STATUS_SENT_ERROR;
+				}
+					run_system_wrapper(dut, "hostapd_cli -i %s %s epcs session_terminate %02x:%02x:%02x:%02x:%02x:%02x",
+							   ifname, link_set ? link_param : "", mac_addr[0], mac_addr[1], mac_addr[2],
+							   mac_addr[3], mac_addr[4], mac_addr[5]);
+			}
+		} else {
