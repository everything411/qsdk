 			fprintf(f, "qos_map_set=%s\n", QOS_MAP_SET_2);
 
+		if (dut->ap_epcs == VALUE_ENABLED) {
+			fprintf(f, "enable_epcs=1\n");
+			fprintf(f, "epcs_wmm_ac_bk_aifs=7\n");
+			fprintf(f, "epcs_wmm_ac_bk_cwmin=4\n");
+			fprintf(f, "epcs_wmm_ac_bk_cwmax=9\n");
+			fprintf(f, "epcs_wmm_ac_bk_txop_limit=0\n");
+			fprintf(f, "epcs_wmm_ac_be_aifs=3\n");
+			fprintf(f, "epcs_wmm_ac_be_cwmin=4\n");
+			fprintf(f, "epcs_wmm_ac_be_cwmax=9\n");
+			fprintf(f, "epcs_wmm_ac_be_txop_limit=0\n");
+			fprintf(f, "epcs_wmm_ac_vi_aifs=2\n");
+			fprintf(f, "epcs_wmm_ac_vi_cwmin=3\n");
+			fprintf(f, "epcs_wmm_ac_vi_cwmax=4\n");
+			fprintf(f, "epcs_wmm_ac_vi_txop_limit=188\n");
+			fprintf(f, "epcs_wmm_ac_vo_aifs=2\n");
+			fprintf(f, "epcs_wmm_ac_vo_cwmin=2\n");
+			fprintf(f, "epcs_wmm_ac_vo_cwmax=3\n");
+			fprintf(f, "epcs_wmm_ac_vo_txop_limit=102\n");
+		}
+
 		fclose(f);
 	}
 
