+static int mac80211_ap_send_frame_t2lmteardown(struct sigma_dut *dut,
+					 struct sigma_cmd *cmd,
+					 const char *ifname)
+{
+	char link_param[10];
+	bool link_set = false;
+	unsigned char peer_mld_macaddr[ETH_ALEN];
+	char buf[100];
+	const char *val;
+	int link_id = 0;
+
+	val = get_param(cmd, "STA_MLD");
+	if (!val || parse_mac_address(dut, val, peer_mld_macaddr) < 0) {
+		sigma_dut_print(dut, DUT_MSG_ERROR,
+				"Sta MLD MAC Address not in proper format");
+		return -1;
+	}
+
+	val = get_param(cmd, "Interface");
+	if (val) {
+		if (strcasecmp(val, "24G") == 0)
+			link_id = dut->band_to_link[0];
+		else if (strcasecmp(val, "5G") == 0)
+			link_id = dut->band_to_link[1];
+		else if (strcasecmp(val, "6G") == 0)
+			link_id = dut->band_to_link[2];
+
+		dut->intf_defined = dut->num_links;
+	}
+
+	if (dut->program == PROGRAM_EHT) {
+		snprintf(link_param, sizeof(link_param), "-l %d", link_id);
+		link_set = true;
+	}
+
+	snprintf(buf, sizeof(buf),
+		"hostapd_cli -i %s %s negotiated_ttlm teardown %02x:%02x:%02x:%02x:%02x:%02x",
+		ifname, link_set ? link_param : "", peer_mld_macaddr[0], peer_mld_macaddr[1], peer_mld_macaddr[2],
+		peer_mld_macaddr[3], peer_mld_macaddr[4], peer_mld_macaddr[5]);
+	sigma_dut_print(dut, DUT_MSG_INFO, "teardown: '%s'\n", buf);
+	run_system(dut, buf);
+
+	return 0;
+}
 
