 	int i;
 	int least_pref = 1 << 8;
@@ -17991,9 +17985,9 @@ static int mac80211_update_mbo_pref_ap_l
 
 	/* Now add the self AP Address */
 	if (dut->mbo_self_ap_tuple.ap_ne_class == -1) {
-		if (check_band(dut, BAND_6G, 0))
+		if (check_band(dut, BAND_6G, link_id))
 			ap_ne_class = 131;
-		else if (dut->ap_channel <= 11)
+		else if (dut->mld[link_id].ap_channel <= 11)
 			ap_ne_class = 81;
 		else
 			ap_ne_class = 115;
@@ -18003,7 +17997,7 @@ static int mac80211_update_mbo_pref_ap_l
 	}
 
 	if (dut->mbo_self_ap_tuple.ap_ne_op_ch == -1) {
-		ap_ne_op_ch = dut->ap_channel;
+		ap_ne_op_ch = dut->mld[link_id].ap_channel;
 		dut->mbo_self_ap_tuple.ap_ne_op_ch = ap_ne_op_ch;
 	} else {
 		ap_ne_op_ch = dut->mbo_self_ap_tuple.ap_ne_op_ch;
@@ -18035,7 +18029,7 @@ static int mac80211_update_mbo_pref_ap_l
 }
 
 static int mac80211_set_nebor(struct sigma_dut *dut, const char *ifname,
-			      struct sigma_cmd *cmd)
+			      struct sigma_cmd *cmd, int link_id)
 {
 	const char *val;
