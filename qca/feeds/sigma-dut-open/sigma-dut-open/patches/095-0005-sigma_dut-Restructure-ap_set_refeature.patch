 				   "ath11k-fwtest -i %s -m 0x4b -v 0 1 0 3 1 3 2 3 3 3",
@@ -18381,7 +18376,7 @@ static int mac80211_set_trigger_type(str
 		mac80211_set_trigger_type_1(dut, ifname);
 		break;
 	case 2:
-		mac80211_set_trigger_type_2(dut, ifname);
+		mac80211_set_trigger_type_2(dut, ifname, link_id);
 		break;
 	case 3:
 		mac80211_set_trigger_type_3(dut, ifname);
@@ -18398,7 +18393,8 @@ static int mac80211_set_trigger_type(str
 
 static enum sigma_cmd_result
 mac80211_tx_bandwidth(struct sigma_dut *dut, struct sigma_conn *conn,
-		      const char *ifname, const char *val, const char *type)
+		      const char *ifname, const char *val,
