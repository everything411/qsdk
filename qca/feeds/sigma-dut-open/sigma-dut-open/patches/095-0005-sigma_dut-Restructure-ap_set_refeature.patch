+					int link_id)
 {
 	/* TriggerType "2" for MU BAR */
-	if (dut->ap_channel >= 36) {
+	if (dut->mld[link_id].ap_channel >= 36) {
 		/* RU allocation RU 242 - DL OFDMA data */
