@@ -18191,7 +18185,7 @@ static int mac80211_set_nebor(struct sig
 				dut->btm[neighbor_cnt].nebor_op_class[0],
 				dut->btm[neighbor_cnt].nebor_op_ch[0],
 				dut->btm[neighbor_cnt].ap_ne_pref);
-		if (mac80211_update_mbo_pref_ap_list(dut))
+		if (mac80211_update_mbo_pref_ap_list(dut, link_id))
 			return -1;
 	}
 
@@ -18304,10 +18298,11 @@ static void mac80211_set_trigger_type_1(
 	mac80211_set_mu_brp_commands(dut, ifname);
 }
 
