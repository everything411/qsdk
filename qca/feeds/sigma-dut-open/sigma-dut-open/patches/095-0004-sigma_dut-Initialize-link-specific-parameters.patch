From 43cd6ee24664eff926d9ed383bc2df6db284fc0a Mon Sep 17 00:00:00 2001
From: Naveen S <quic_naves@quicinc.com>
Date: Wed, 4 Sep 2024 17:49:52 +0530
Subject: [PATCH] sigma_dut: Initialize link specific parameters

Setting the default values for the link specific
parameters

Signed-off-by: Dhanavandhana Kannan <quic_dhanavan@quicinc.com>
Signed-off-by: Naveen S <quic_naves@quicinc.com>
---
 ap.c | 51 +++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 47 insertions(+), 4 deletions(-)

--- a/ap.c
+++ b/ap.c
@@ -12713,7 +12713,6 @@ static enum sigma_cmd_result cmd_ap_rese
 	dut->ap_su_txBF = 1;
 	dut->ap_channel = -1;
 	dut->ap_chwidth = AP_AUTO;
-	memset(dut->ap_link_chwidth, -1, sizeof(dut->ap_link_chwidth));
 	dut->ap_ampdu_exp = 0;
 	dut->ap_max_mpdu_len = 0;
 	dut->ap_band_6g = 0;
@@ -12741,14 +12740,11 @@ static enum sigma_cmd_result cmd_ap_rese
 	/* Resetting this interface specific pmf value to -1, as it will
 	 * get changed only for interface specific cases as given by the user
 	 */
-	memset(dut->ap_pmf_link, -1, sizeof(dut->ap_pmf_link));
 
 	dut->wsc_fragment = 0;
 	dut->eap_fragment = 0;
 	dut->wps_forced_version = 0;
 
-	dut->dtim = 0;
-	dut->dtim_1 = 0;
 	dut->eht_txemlomn = VALUE_NOT_SET;
 	dut->cohost_iface = 0;
 	dut->ap_cohosted_bss = VALUE_NOT_SET;
@@ -12776,7 +12772,6 @@ static enum sigma_cmd_result cmd_ap_rese
 	dut->ap_tnc_time_stamp = 0;
 
 	dut->ap_akm_values = 0;
-	memset(dut->ap_akm_link_values, VALUE_NOT_SET, sizeof(dut->ap_akm_link_values));
 	free(dut->ap_sae_passwords);
 	dut->ap_sae_passwords = NULL;
 	dut->ap_sae_pk = 0;
@@ -13227,6 +13222,53 @@ static enum sigma_cmd_result cmd_ap_rese
 				"60G WPS: configure secure AP with random passphrase");
 	}
 
+	memset(&dut->mld[0], 0, sizeof(struct mld_ap));
+
+	for (int i = 0; i < NUM_OF_LINKS; i++) {
+		dut->mld[i].ap_channel = -1;
+		dut->mld[i].ap_mode = AP_inval;
+		dut->mld[i].ap_band = BAND_UNKNOWN;
+		dut->mld[i].ap_chwidth = AP_AUTO;
+		dut->mld[i].dtim = 0;
+		dut->mld[i].ap_akm_link = 0;
+		dut->mld[i].ap_pmf_link = AP_PMF_DISABLED;
+		dut->mld[i].ap_psk_link[0] = '\0';
+		dut->mld[i].ap_beacon_prot_link = dut->user_config_ap_beacon_prot;
+		dut->mld[i].ap_cipher_link = AP_CCMP;
+		dut->mld[i].ap_group_cipher_link = AP_NO_GROUP_CIPHER_SET;
+		dut->mld[i].ap_group_mgmt_cipher_link = AP_NO_GROUP_MGMT_CIPHER_SET;
+		free(dut->mld[i].ap_sae_groups_link);
+		dut->mld[i].ap_sae_groups_link = NULL;
+
+		if (dut->program == PROGRAM_EHT) {
+			dut->mld[i].ap_pmf_link = AP_PMF_OPTIONAL;
+			dut->mld[i].ap_beacon_prot_link = 1;
+			dut->mld[i].ap_group_mgmt_cipher_link = AP_BIP_GMAC_256;
+		}
+
+		if (dut->mld[i].ap_mode == AP_11be)
+			dut->mld[i].ap_beacon_prot_link = 1;
+
+		if (dut->program == PROGRAM_VHT) {
+			dut->mld[i].ap_channel = 36;
+			dut->mld[i].ap_chwidth = AP_80;
+			dut->mld[i].ap_mode = AP_11ac;
+		}
+
+		if (dut->program == PROGRAM_MBO) {
+			dut->mld[i].ap_channel = 36;
+			dut->mld[i].ap_chwidth = AP_20;
+		}
+
+		if (is_60g_sigma_dut(dut)) {
+			dut->mld[i].ap_channel = 2;
+			dut->mld[i].ap_mode = AP_11ad;
+		}
+	}
+
+	dut->link_specific_security = 0;
+	dut->multi_mld = 0;
+
 	dut->hostapd_running = 0;
 	dut->ap_scs = VALUE_NOT_SET;
 
--- a/sigma_dut.h
+++ b/sigma_dut.h
@@ -1377,8 +1377,6 @@ struct sigma_dut {
 	char host_name[100];
 	int sta_roaming_disabled;
 
-	int dtim;
-	int dtim_1;
 	int switch_he_eht;
 	int cohost_iface;
 	int ap_cohosted_bss;
