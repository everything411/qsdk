+/*
+ * get_phy_from_iface - resolve phy name via sysfs symlink.
+ * /sys/class/net/<ifname>/phy80211 -> ../../ieee80211/phyXX
+ */
+static void get_phy_from_iface(const char *ifname, char *phy, size_t len)
+{
+	char path[128], link[128], *p;
+	ssize_t r;
+
+	snprintf(phy, len, "phy0"); /* fallback */
+	snprintf(path, sizeof(path), "/sys/class/net/%s/phy80211", ifname);
+	r = readlink(path, link, sizeof(link) - 1);
+	if (r <= 0)
+		return;
+	link[r] = '\0';
+	p = strrchr(link, '/');
+	if (p)
+		snprintf(phy, len, "%s", p + 1);
+}
