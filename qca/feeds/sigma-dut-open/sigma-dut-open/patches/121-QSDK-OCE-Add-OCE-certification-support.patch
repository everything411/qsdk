+/*
+ * oce_rnr_scan_and_update - Discover external neighbor APs via a
+ * temporary STA VAP, populate hostapd's neighbor DB, and rebuild beacons
+ * so OCE AP Channel Report and RNR IEs reflect all co-located and
+ * neighboring BSSes (e.g. CTT APs on ch40 and ch11).
+ *
+ * AP-mode driver scans do not return results on ath12k (confirmed).
+ * A STA-mode interface on the same phy can scan all channels.  After
+ * the scan, iw output is parsed to extract BSSID/freq pairs which are
+ * added to hostapd's neighbor DB via SET_NEIGHBOR before UPDATE_BEACON.
+ *
+ * Triggered by: (1) background fork at ap_config_commit +90s (TC 4.5.x);
+ *               (2) DownlinkAvailCap set via ap_set_rfeature (TC 4.8.x).
+ */
+static void oce_ssid_to_hex(const char *ssid, char *hex, size_t hex_len)
+{
+	size_t i, slen = strlen(ssid);
+
+	hex[0] = '\0';
+	for (i = 0; i < slen && (i * 2 + 2) < hex_len; i++)
+		snprintf(hex + i * 2, 3, "%02x", (unsigned char)ssid[i]);
+}
+
+static void oce_add_neighbor(const char *ifname, const char *bssid,
+			     const char *ssid, int freq)
+{
+	unsigned int b[6];
+	int op_class, channel;
+	char ssid_hex[129], cmd[512];
+
+	if (freq >= 2412 && freq <= 2484) {
+		op_class = 81;
+		channel = (freq - 2407) / 5;
+	} else if (freq >= 5180 && freq <= 5320) {
+		op_class = 115;
+		channel = (freq - 5000) / 5;
+	} else if (freq >= 5500 && freq <= 5720) {
+		op_class = 121;
+		channel = (freq - 5000) / 5;
+	} else if (freq >= 5725 && freq <= 5850) {
+		op_class = 125;
+		channel = (freq - 5000) / 5;
+	} else {
+		return;
+	}
+
+	sscanf(bssid, "%x:%x:%x:%x:%x:%x",
+	       &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]);
+	oce_ssid_to_hex(ssid, ssid_hex, sizeof(ssid_hex));
+	snprintf(cmd, sizeof(cmd),
+		 "hostapd_cli -p /var/run/hostapd -i %s"
+		 " set_neighbor %s ssid=%s"
+		 " nr=%02x%02x%02x%02x%02x%02x00000000%02x%02x01",
+		 ifname, bssid, ssid_hex,
+		 b[0], b[1], b[2], b[3], b[4], b[5],
+		 op_class, channel);
+	system(cmd);
+}
+
+static void oce_rnr_scan_and_update(struct sigma_dut *dut, const char *ifname)
+{
+	char phy[32], cmd[256], line[256];
+	FILE *fp;
+	char nb_bssid[20] = {0};
+	int nb_freq = 0;
+	char nb_ssid[64] = {0};
+	int i;
+
+	get_phy_from_iface(ifname, phy, sizeof(phy));
+
+	/*
+	 * Bring down all AP interfaces before scanning so ath12k can
+	 * scan off-channel (e.g., 2.4G ch1 while APs run on ch6).
+	 */
+	for (i = 0; i < dut->num_links; i++) {
+		snprintf(cmd, sizeof(cmd),
+			 "ip link set wlan%d down 2>/dev/null", i);
+		run_system(dut, cmd);
+	}
+
+	/* Create a temporary STA VAP on the same phy for full-band scan */
+	snprintf(cmd, sizeof(cmd),
+		 "iw phy %s interface add wlanoce_scan type managed 2>/dev/null",
+		 phy);
+	run_system(dut, cmd);
+	run_system(dut, "ip link set wlanoce_scan up 2>/dev/null");
+
+	/* Trigger full-band scan: 2.4G (ch1-14) + 5G (ch36-165) */
+	run_system(dut,
+		   "iw dev wlanoce_scan scan freq "
+		   "2412 2417 2422 2427 2432 2437 2442 2447 2452 2457 2462 "
+		   "5180 5200 5220 5240 5260 5280 5300 5320 5500 5520 5540 "
+		   "5560 5580 5600 5620 5640 5660 5680 5700 5720 5745 5765 "
+		   "5785 5805 5825 2>/dev/null");
+	sleep(8);
+
+	/*
+	 * Parse iw scan dump: for each discovered BSS build a minimal
+	 * Neighbor Report element (BSSID + info + op_class + channel +
+	 * PHY type = 13 bytes) and add it to hostapd's neighbor DB.
+	 */
+	fp = popen("iw dev wlanoce_scan scan dump 2>/dev/null", "r");
+	if (fp) {
+		while (fgets(line, sizeof(line), fp)) {
+			char *p = line;
+
+			if (strncmp(p, "BSS ", 4) == 0) {
+				if (nb_bssid[0] && nb_freq)
+					oce_add_neighbor(ifname, nb_bssid,
+							 nb_ssid, nb_freq);
+				sscanf(p + 4, "%17s", nb_bssid);
+				nb_freq = 0;
+				nb_ssid[0] = '\0';
+			} else if (strstr(p, "freq:")) {
+				sscanf(p, " freq: %d", &nb_freq);
+			} else if (strstr(p, "\tSSID:")) {
+				sscanf(p, " SSID: %63[^\n]", nb_ssid);
+			}
+		}
+		/* Flush last entry */
+		if (nb_bssid[0] && nb_freq)
+			oce_add_neighbor(ifname, nb_bssid, nb_ssid, nb_freq);
+		pclose(fp);
+	}
+
+	run_system(dut, "iw dev wlanoce_scan del 2>/dev/null");
+
+	/* Restore AP interfaces */
+	for (i = 0; i < dut->num_links; i++) {
+		snprintf(cmd, sizeof(cmd),
+			 "ip link set wlan%d up 2>/dev/null", i);
+		run_system(dut, cmd);
+	}
+	sleep(2); /* allow APs to re-establish */
+
+	/* Rebuild beacons on ALL managed interfaces */
+	for (i = 0; i < dut->num_links; i++) {
+		snprintf(cmd, sizeof(cmd),
+			 "hostapd_cli -p /var/run/hostapd -i wlan%d UPDATE_BEACON", i);
+		run_system(dut, cmd);
+	}
+
+	sigma_dut_print(dut, DUT_MSG_INFO,
+			"OCE RNR: scan + neighbor update complete on %s", ifname);
+}
