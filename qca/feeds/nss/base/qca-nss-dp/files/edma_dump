	rxdesc_prod=$((($rxdesc_ring_base + 0x4) + ($ring_base_multiple*$ring_n)))
	prod_val=$(devmem $(hex_addr $rxdesc_prod))
	echo "rxdesc_prod[$ring_n] addr:$(hex_addr $rxdesc_prod) index: $prod_val"

