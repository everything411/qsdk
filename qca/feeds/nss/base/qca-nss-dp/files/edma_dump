	;;
ipq54xx)
	load_marina
	;;
ipq52xx)
	load_hermosa
	;;
ipq96xx)
	load_juhu
	;;
*)
	echo 'edma_dump [ipq53xx|ipq95xx|ipq54xx|ipq52xx|ipq96xx] [general|txdesc|txcmpl|rxdesc|rxfill|full] [ring_num] [cache] [8B_mode]'
