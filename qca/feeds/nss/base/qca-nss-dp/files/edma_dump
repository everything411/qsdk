		for i in $(seq 0 $(($RX_BIN_CNT - 1)))
		do
			reg=$((($1 + 0xFA320) + (0x4*$i)))
			dump_reg "NSS_PPE_EDMA_RX_BIN_CNT_HIGH_REG_$i" $reg
		done
		for i in $(seq 0 $(($RX_BIN_CNT - 1)))
		do
			reg=$((($1 + 0xFA340) + (0x4*$i)))
			dump_reg "NSS_PPE_EDMA_RX_BIN_CNT_THRES_REG_$i" $reg
		done
		dump_reg "NSS_PPE_EDMA_RX_BIN_CTRL_REG" $(($1 + 0xFA360))
	fi
}

