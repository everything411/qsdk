	rxdesc_cons=$((($rxdesc_ring_base + 0x8) + ($ring_base_multiple*$ring_n)))
	cons_val=$(devmem $(hex_addr $rxdesc_cons))
	echo "rxdesc_cons[$ring_n] addr:$(hex_addr $rxdesc_cons) index: $cons_val"

