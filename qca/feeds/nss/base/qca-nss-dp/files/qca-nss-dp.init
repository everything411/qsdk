START=18

qca_nss_dp_dependency() {
	while [ -e /lib/modules/$(uname -r)/qca-nss-dp.ko ] && [ ! -d /sys/module/qca_nss_dp ]
	do
		sleep 1
	done
}

enable_rps() {

	# Detect platform to determine core count and RPS core usage
	# Default to 4 cores (threshold 8) and 3 RPS cores, use 5 RPS cores
	# (threshold 16) for IPQ96XX
	local core_threshold=8
	local num_cores=3

	local arch=$(uname -m 2>/dev/null)

	# Check device tree model for IPQ96XX. Use 5 RPS cores only on 64-bit
	# profile (aarch64); keep default core settings for 32-bit profile.
	if [ -f /proc/device-tree/model ]; then
		model=$(cat /proc/device-tree/model 2>/dev/null)
		case "$model" in
			*IPQ96*|*ipq96*)
				if [ "$arch" = "aarch64" ]; then
					core_threshold=16
				fi
				;;
		esac
	fi

	# Alternative: Check board name if device tree not available
	if [ $core_threshold -eq 8 ] && [ -f /tmp/sysinfo/board_name ]; then
		board=$(cat /tmp/sysinfo/board_name 2>/dev/null)
		case "$board" in
			*ipq96*|*IPQ96*)
				if [ "$arch" = "aarch64" ]; then
					core_threshold=16
				fi
				;;
		esac
	fi

	i=1
	irq_rps=`grep edma_rxdesc /proc/interrupts | grep -v edma_rxdesc_gro | cut -d ':' -f 1 | tr -d ' '`
	for entry in $irq_rps
	do
		printf "%x\n" "$i" > /proc/irq/$entry/smp_affinity
		i=$(expr $i \* 2)
		if [ $i -gt $core_threshold ];then
			i=1
		fi
	done

	# Assign SMP affinity for HW GRO RX rings separately, starting from
	# CPU0, so their assignment is independent of non-GRO rxdesc rings.
	i=1
	irq_rps=`grep edma_rxdesc_gro /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
	for entry in $irq_rps
	do
		printf "%x\n" "$i" > /proc/irq/$entry/smp_affinity
		i=$(expr $i \* 2)
		if [ $i -gt $core_threshold ];then
			i=1
		fi
	done

	i=1
        irq_rps=`grep edma_rxfill /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
        for entry in $irq_rps
        do
                printf "%x\n" "$i" > /proc/irq/$entry/smp_affinity
                i=$(expr $i \* 2)
                if [ $i -gt $core_threshold ];then
                        i=1
                fi
        done

	i=1
	irq_rps=`grep edma_txcmpl /proc/interrupts | cut -d ':' -f 1 | tr -d ' '`
	for entry in $irq_rps
	do
		printf "%x\n" "$i" > /proc/irq/$entry/smp_affinity
		i=$(expr $i \* 2)
		if [ $i -gt $core_threshold ];then
			i=1
		fi
	done

	# Enable RPS core count based on platform
	echo $num_cores > /proc/sys/net/edma/rps_num_cores
}

start() {
	qca_nss_dp_dependency
	local rps_enabled="$(uci_get qca_nss_dp @general[0] enable_rps)"
	if [ "$rps_enabled" -eq 1 ]; then
		enable_rps
	fi
}
