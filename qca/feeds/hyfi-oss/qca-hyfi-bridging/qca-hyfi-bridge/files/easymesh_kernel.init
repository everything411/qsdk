. /lib/wifi/wifi-utils.sh
START=20

boot() {
    local KO_PATH="$(get_ap_sdxpinn_ko_path)"

    [ -f $KO_PATH/emesh-sp.ko ] && insmod "$KO_PATH/emesh-sp.ko"
    [ -f $KO_PATH/hyfi-bridging.ko ] && insmod "$KO_PATH/hyfi-bridging.ko"
}
