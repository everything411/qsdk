[ "$ACTION" = add ] || exit 0
[[ $INTERFACE == *"rmnet_mhi"* || $INTERFACE == *"rmnet_data"* ]] || exit 0
BRIDGE_NAME="$INTERFACE"
[ -d "/sys/class/net/$BRIDGE_NAME" ] || exit 0
tc qdisc replace dev $BRIDGE_NAME root htb
exit 0
