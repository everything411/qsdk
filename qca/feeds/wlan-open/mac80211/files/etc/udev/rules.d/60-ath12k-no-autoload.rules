# Prevent udev from auto-loading ath12k/ath12k_wifi8 on PCI hotplug.
# These modules must be loaded by wififw-mount.service after firmware is ready.
# Clearing ENV{MODALIAS} suppresses the generic kmod-load rule in 80-drivers.rules.
ENV{MODALIAS}=="pci:v000017CBd00001113*", ENV{MODALIAS}=""
ENV{MODALIAS}=="pci:v000017CBd00001114*", ENV{MODALIAS}=""
