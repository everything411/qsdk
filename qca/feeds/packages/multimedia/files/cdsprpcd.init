START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/cdsprpcd
SERVICE_USER=fastrpc
SERVICE_GROUP=fastrpc
SERVICE_SUPP_GROUPS=kmem

start_service() {
	procd_open_instance
	procd_set_param command $PROG

	# Run as fastrpc user and group with kmem supplementary group
	procd_set_param user $SERVICE_USER
	procd_set_param group $SERVICE_GROUP $SERVICE_SUPP_GROUPS

	# Enable automatic restart on crash
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}

	# Set stdout and stderr to syslog
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cdsprpcd"
}
