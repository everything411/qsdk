r95-02-UPSTREAM-PROTOCOL-hostapd-Implement-CLI-to-validate.patch,
r99-UPSTREAM-PROTOCOL-hostapd-Fix-AFC-channel-bandwidth-.patch,
s005-UPSTREAM-PROTOCOL-hostapd-Fix-AFC-random-channel-sel.patch

Signed-off-by: Guru Pratap Sharma <guruprat@qti.qualcomm.com>
---
 src/ap/ap_config.c    |  1 +
 src/ap/ap_config.h    |  1 +
 src/ap/interference.c | 11 +++++++++++
 3 files changed, 13 insertions(+)

diff --git a/src/ap/ap_config.c b/src/ap/ap_config.c
index 1a75c81..4174027 100644
--- a/src/ap/ap_config.c
+++ b/src/ap/ap_config.c
@@ -374,6 +374,7 @@ struct hostapd_config * hostapd_config_defaults(void)
 	conf->enable_6ghz_composite_ap = 1;
 	conf->cur_chan_eirp = CHAN_MIN_EIRP_POWER;
 	conf->afc_chan_sel_config = HOSTAPD_AFC_CHAN_SEL_ALL;
+	conf->original_chan_width = 0;
 
 	hostapd_set_and_check_bw320_offset(conf, 0);
 
diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index 272e7f8..ea78517 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1364,6 +1364,7 @@ struct hostapd_config {
 	bool enable_mcs15;
 	int afc_chan_sel_config;
 	int cur_chan_eirp;
+	int original_chan_width; /* Original channel width for AFC */
 
 };
 
diff --git a/src/ap/interference.c b/src/ap/interference.c
index 239be69..714c780 100644
--- a/src/ap/interference.c
+++ b/src/ap/interference.c
@@ -1472,6 +1472,17 @@ int hostapd_intf_afc_received(struct hostapd_iface *iface)
 	chan_width = hostapd_get_chan_width_from_oper_chan_width(iface->conf);
 	wpa_printf(MSG_DEBUG, "chan_width=%d", chan_width);
 
+	/* Store the original channel width on first AFC request */
+	if (iface->conf->original_chan_width == 0) {
+		iface->conf->original_chan_width = chan_width;
+		wpa_printf(MSG_DEBUG, "AFC: Storing original channel width: %d",
+			   iface->conf->original_chan_width);
+	} else {
+		/* Use the original channel width as starting point for subsequent requests */
+		chan_width = iface->conf->original_chan_width;
+		wpa_printf(MSG_DEBUG, "AFC: Using original channel width: %d", chan_width);
+	}
+
 	chan_data = os_zalloc(sizeof(struct hostapd_channel_data));
 	if (!chan_data) {
 		wpa_printf(MSG_ERROR, "chan_data memory allocation failed");
-- 
