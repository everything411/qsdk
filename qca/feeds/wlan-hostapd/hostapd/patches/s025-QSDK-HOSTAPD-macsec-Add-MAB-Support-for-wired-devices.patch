+	nl_send_mac_poll(drv, 1);
+	return 0;
+out_free:
+	if (drv->nl) {
+		nl_socket_free(drv->nl);
+		drv->nl = NULL;
+	}
+	if (drv->nl_event) {
+		nl_socket_free(drv->nl_event);
+		drv->nl_event = NULL;
+	}
+	if (drv->nl_cb) {
+		nl_cb_put(drv->nl_cb);
+		drv->nl_cb = NULL;
+	}
+	return -1;
+}
