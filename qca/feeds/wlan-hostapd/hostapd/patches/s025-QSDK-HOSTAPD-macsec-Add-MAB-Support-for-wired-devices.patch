+
+	wpa_printf(MSG_MSGDUMP, "macsec_qca: Event message available");
+
+	res = nl_recvmsgs(handle, cb);
+	if (res < 0) {
+		wpa_printf(MSG_INFO, "macsec_qca: %s->nl_recvmsgs failed: %d",
+			   __func__, res);
+	}
+}
