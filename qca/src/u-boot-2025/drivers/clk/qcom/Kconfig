if ARCH_SNAPDRAGON || ARCH_IPQ40XX || ARCH_IPQ

config CLK_QCOM
	bool
	depends on CLK && DM_RESET && POWER_DOMAIN
	def_bool n

config CLK_QCOM_PLL
	bool "Qualcomm generic PLL clock support"
	depends on CLK && DM
	help
	  Enable a generic PLL clock framework for IPQ platforms.

config CLK_QCOM_ALL
       bool "Qualcomm generic ALL clock support"
       depends on CLK && DM
       help
         Enable a generic ALL clock framework for IPQ platforms.

menu "Qualcomm clock drivers"

config CLK_QCOM_APQ8016
	bool "Qualcomm APQ8016 GCC"
	select CLK_QCOM
	help
	  Say Y here to enable support for the Global Clock Controller
	  on the Snapdragon APQ8016 SoC. This driver supports the clocks
	  and resets exposed by the GCC hardware block.

config CLK_QCOM_APQ8096
	bool "Qualcomm APQ8096 GCC"
	select CLK_QCOM
	help
